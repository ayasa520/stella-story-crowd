  "uninstalledConfirmedRows": [
    {
      "sceneId": 10040051,
      "scenarioId": 18,
      "ordinal": 16,
      "stableKey": "s10040051-p29-at0140",
      "sourceText": "あと、『最優の騎士』が本名じゃ目立ちすぎちまう。だから、ユーリって呼ばせてもらうぜ。それでいいよな？",
      "confirmedCharacter": "live2d/AC_subaru01",
