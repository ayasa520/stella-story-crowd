","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg134a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020021:10","scenario_id":10,"scene_id":"scene:10020021","kind":"card","title_mode":"","speaker":"フェリちゃん","text":"ありゃ、ヴィル爺の言う通り、結構派手にやっちゃってるね","translation":"哎呀，威尔爷说得没错，摔得还挺惨的呢。","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg134a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020021:11","scenario_id":11,"scene_id":"scene:10020021","kind":"card","title_mode":"","speaker":"ヴィル爺","text":"……フェリス、治して差し上げては？","translation":"……菲莉丝，替他治疗一下如何？","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg134a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020021:12","scenario_id":12,"scene_id":"scene:10020021","kind":"card","title_mode":"","speaker":"フェリス","text":"ぶつかってきたのはこの子なのに……もう、しょうがにゃいんだから。フェリちゃんが治したげるから見せて","translation":"明明是他撞过来的……真拿你没办法喵。让菲莉酱帮你治，伤口给我看看。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":