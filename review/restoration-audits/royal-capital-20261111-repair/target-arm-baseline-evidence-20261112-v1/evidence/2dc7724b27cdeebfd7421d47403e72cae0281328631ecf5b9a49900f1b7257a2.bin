","title_mode":"","speaker":"スバル","text":"ちょうどよかった!今、まさにあんたの手が必要だったんだ！","translation":"来得正好！我现在正需要你帮忙！","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020048:9","scenario_id":9,"scene_id":"scene:10020048","kind":"card","title_mode":"","speaker":"ユリウス","text":"落ち着いてほしい。\n危急の事態のようだが、\nいったい何があったんだ？","translation":"请先冷静。似乎是紧急情况，到底发生了什么事？","model":"julius01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020048:10","scenario_id":10,"scene_id":"scene:10020048","kind":"card","title_mode":"","speaker":"ユリウス","text":"私を見込んで、ということか","translation":"也就是说，你认为我能帮上忙？","model":"julius01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020048:11","scenario_id":11,"scene_id":"scene:10020048","kind":"card","title_mode":"","speaker":"スバル","text":"どうにか頼む。冗談でも悪戯でもねえんだ","translation":"拜托了。我不是开玩