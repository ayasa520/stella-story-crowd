"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg013a_street","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040001:9","scenario_id":9,"scene_id":"scene:10040001","kind":"card","title_mode":"","speaker":"スバル","text":"……でもよ、自分が切羽詰まってても、人のこと助けちまうお人好しもいるんだよな……","translation":"……可是，也有人，哪怕自己已被逼到绝境，还是会去帮助别人啊……","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg013a_street","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040001:10","scenario_id":10,"scene_id":"scene:10040001","kind":"card","title_mode":"","speaker":"スバル","text":"大切なもの盗まれて、それどころじゃないのに無関係の役立たずを助けて、治療までしてやって……","translation":"重要的东西被偷，明明已经顾不上其他，还救下毫不相干、毫无用处的家伙，甚至帮忙治疗……","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg013a_street","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040001:11","scenario_id":11,"scene_id":"scene:10040001","kind":"card","title_mode":"","speaker":"スバル","text":"たとえ、あの子と俺が出会わなくても、\nフェルトは徽章を盗んで、\nそしてエルザの奴がみんなを……","translation":"就算她没和我相遇，菲鲁特还是会偷走徽章，然后艾尔莎，就会把大家……","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"",