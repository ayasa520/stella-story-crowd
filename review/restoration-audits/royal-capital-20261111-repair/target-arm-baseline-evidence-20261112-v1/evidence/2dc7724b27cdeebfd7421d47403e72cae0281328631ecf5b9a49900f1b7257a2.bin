":"","speaker":"ロム爺","text":"じゃが、危なくなったら逃げる。それは絶対じゃからな！","translation":"不过，遇到危险就逃。这点，绝不能忘！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg023b_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10450056:1","scenario_id":1,"scene_id":"scene:10450056","kind":"title","title_mode":"scene","speaker":"","text":"力を合わせて","translation":"齐心协力","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"","source_scenario_id":null},"native_video":null,"native_unsupported":""},{"id":"10450056:2","scenario_id":2,"scene_id":"scene:10450056","kind":"text","title_mode":"","speaker":"","text":"――白熱するユリウスとエルザの戦闘。\nそこにスバルも予期せぬ助っ人が現れる。\n果たして結末は……","translation":"——尤里乌斯与艾尔莎的战斗愈发激烈。就在这时，连昴也未曾预料到的帮手现身了。结局，究竟如何……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"bg/bg031b_stealshop","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10450056:3","scenario_id":3,"scene_id":"scene:10450056","kind":"text","title_mode":"","speaker":"","text":"――盗品蔵・夕刻","translation":"——赃物库·傍晚","model":"","body":"","face":"","extra_