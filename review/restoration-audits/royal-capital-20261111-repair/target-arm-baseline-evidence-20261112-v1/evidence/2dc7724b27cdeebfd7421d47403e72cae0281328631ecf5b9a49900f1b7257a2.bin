"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020036:5","scenario_id":5,"scene_id":"scene:10020036","kind":"card","title_mode":"","speaker":"スバル","text":"とりあえず、順番に話すぞ。俺は、とある徽章を探してる。俺を助けてくれた銀髪美少女の持ち物だ","translation":"总之，我从头说起。我在找一枚徽章，是救过我的银发美少女的东西。","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020036:6","scenario_id":6,"scene_id":"scene:10020036","kind":"card","title_mode":"","speaker":"巨大な体躯の老人","text":"銀髪？\nそれはまた厄介そうな相手じゃの","translation":"银发？那还真是个麻烦的人物啊。","model":"rom01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020036:7","scenario_id":7,"scene_id":"scene:10020036","kind":"card","title_mode":"","speaker":"スバル","text":"厄介って、何がだ？","translation":"麻烦？什么麻烦？","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",