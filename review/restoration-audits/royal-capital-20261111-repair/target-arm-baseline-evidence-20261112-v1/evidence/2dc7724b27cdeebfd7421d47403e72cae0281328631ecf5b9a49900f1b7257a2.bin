],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10240046:6","scenario_id":6,"scene_id":"scene:10240046","kind":"card","title_mode":"","speaker":"スバル","text":"本当にすげぇ！お前らすげぇよ！すごすぎて語彙力なくなっちまうくらいに！","translation":"真的太厉害了！你们好强！强得我都不知道该说什么好了！","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10240046:7","scenario_id":7,"scene_id":"scene:10240046","kind":"card","title_mode":"","speaker":"リカード","text":"ま、わりとギリギリやったけどなあ！","translation":"不过，其实也挺险的！","model":"ricardo01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10240046:8","scenario_id":8,"scene_id":"scene:10240046","kind":"card","title_mode":"","speaker":"リカード","text":"しかし、なんちゅう相手や。兄ちゃん庇いながらやったのもあるけど、かなり危なかったわ！","translation":"真是个厉害的对手。虽然也因为要保护小哥你，但确实相当危险！","model":"ricardo01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10240046:9","scenario_id":9,"scene_id":"scene:10240046","kind":"card","title_mode":"","speaker":"リカード","text":"ミミが世話んなった恩返しのつもりが、\nなかなか大盤振る舞いやったな！\nガハハハ！！","translation":"本来只是想报答你照顾蜜蜜，没想到还真是份大礼啊！嘎哈哈哈！！","model":"ricardo01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10240046:10","scenario_id":10,"scene_id":"scene:10240046","kind":"card","title_mode":"","speaker":"ミミ","text":"がははははー！\nミミ、チョーがんばった！\nカンムリョー！","translation":"嘎哈哈哈！蜜蜜超级努力！感慨万千！","model":"mimi01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10240046:11","scenario_id":11,"scene_id":"scene:10240046","kind":"card","title_mode":"","speaker":"スバル","text":"ああ、おかげで命拾いしたぜ。二人がいなかったらどうなってたことか","translation":"嗯，多亏你们才捡回一条命。要是你们不在，真不知道会怎么样。","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"na