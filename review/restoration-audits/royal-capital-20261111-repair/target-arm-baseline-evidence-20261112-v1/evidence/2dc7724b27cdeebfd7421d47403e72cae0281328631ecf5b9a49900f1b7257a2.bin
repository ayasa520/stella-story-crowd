:[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg046c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10450058:22","scenario_id":22,"scene_id":"scene:10450058","kind":"card","title_mode":"","speaker":"銀髪の少女","text":"そう？特別なことじゃないと思うけど、なんだか不思議な子ね","translation":"是吗？我觉得也不是什么特别的事。不过，你真是个不可思议的孩子。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg046c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10450058:23","scenario_id":23,"scene_id":"scene:10450058","kind":"card","title_mode":"","speaker":"スバル","text":"んで……多大なる貢献をした俺！そして、それに助けられたヒロインが、君！","translation":"然后……做出巨大贡献的人，是我！而得到帮助的女主角，就是你！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg046c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10450058:24","scenario_id":24,"scene_id":"scene:10450058","kind":"card","title_mode":"","speaker":"スバル","text":"そんなら相応のお礼があっても、いいんじゃないか?ないかなぁ!？","translation":"既然如此，给我相应的谢礼，也不过分吧？不过分吧！？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","charac