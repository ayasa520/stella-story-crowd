de":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:38","scenario_id":38,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"スバル","text":"お、お前ら……!?無事だったのか……って、なんでここに！？","translation":"你、你们……！？原来没事啊……不对，为什么会在这里！？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:39","scenario_id":39,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"エミリア","text":"ええと、あの二人とは王都で知り合って、すごーく色々あったんだけど、怖い人に追われてるみたいだったから……","translation":"呃，我在王都认识了他们，发生了很～多事，不过他们好像被一个可怕的人追着……","model":"emilia01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:40","scenario_id":40,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"スバル","text":"だから、君が助けたのか？だって、あいつらは君から徽章を……","translation":"所以，你救了他们？可他们不是从你那里偷走了徽章……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:41","scenario_id":41,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"エミリア","text":"し、仕方ないでしょ！\n放っておいたら後味がすごーく悪いし、\nそれに徽章の隠し場所もわからなくなるもの","translation":"那、那也是没办法嘛！放着不管，会很～过意不去，而且也会不知道徽章藏在哪里啊。","model":"emilia01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:42","scenario_id":42,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"スバル","text":"……けど、それを俺が見つけ出した。で、君に返すために持ってきたわけだ。あの二人、追い出すかい?","translation":"……不过，被我找到了。所以，我才拿来还给你。要把那两个人赶出去吗？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:43","scenario_id":43,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"エミリア","text":"それは……","translation":"这……","model":"emilia01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:44","scenario_id":44,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"スバル","text":"冗談。今のは意地悪言ったんだ。\n――おい、そっちの爺さんと孫娘、\nお前らのビビってる女はもう追ってこねえよ","translation":"开玩笑的。刚才故意逗你呢。——喂，那边的爷爷和孙女，你们害怕的那个女人，已经不会追来了。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:45","scenario_id":45,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"フェルト","text":"は?なんだよ。なんで兄ちゃんにそんなことわかんだ？適当なこと言ってんじゃね一ぞ","translation":"哈？什么啊。哥哥怎么知道？别随口胡说八道！","model":"felt01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:46","scenario_id":46,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"スバル","text":"適当じゃなく、追っ払ったんだよ。俺たちも、こいつを持ってたせいであいつにつけ狙われたんでな","translation":"没胡说，是我们把她赶跑了。因为拿着这东西，我们也被她盯上了。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:47","scenario_id":47,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"スバル","text":"だから、あの二人ももう安心だ。……徽章、受け取ってもらえる？","translation":"所以，他们两个也已经安全了。……徽章，你愿意收下吗？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:48","scenario_id":48,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"エミリア","text":"……あなた、すごーく不思議な子ね。\n言ってること、一個もしっくりこないのに","translation":"……你真是个很～不可思议的孩子。说的那些话，我一句也想不明白。","model":"emilia01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:49","scenario_id":49,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"エミリア","text":"でも、嘘は言ってないように見える。……なくしもの、届けてくれてありがとう","translation":"不过，看起来并没有说谎。……谢谢你，把遗失的东西送回来。","model":"emilia01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:50","scenario_id":50,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"スバル","text":"。どういたしまして、だ。ユーアーウエルカムと言い換えてもよし","translation":"不客气。换成『You're welcome』也行。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:51","scenario_id":51,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"エミリア","text":"ごめん、\nちょっと何言ってるのかわかんない","translation":"抱歉，我有点听不懂你在说什么。","model":"emilia01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:52","scenario_id":52,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"エミリア","text":"……私、どうしたらいい？あなたが、ええと……","translation":"……我该怎么办呢？你，那个……","model":"emilia01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:53","scenario_id":53,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"スバル","text":"?あ、ああ、そうか。俺の名前はナツキ・スバル、だ","translation":"？啊，对啊。我叫菜月昴。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:54","scenario_id":54,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"エミリア","text":"スバル。","translation":"昴。","model":"emilia01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:55","scenario_id":55,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"スバル","text":"お、おう、イエス。俺の名前。急に呼ばれて照れ臭いぜ","translation":"哦、哦，Yes。是我的名字。突然这么叫，怪不好意思的。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:56","scenario_id":56,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"エミリア","text":"私、どうしたらいい？\nスバルが徽章を届けてくれて、\nそれですごーく感謝してる。お礼がしたいの","translation":"我该怎么办呢？昴帮我把徽章送回来，我真的非～常感激。我想谢谢你。","model":"emilia01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:57","scenario_id":57,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"スバル","text":"いや、けど、これは俺の恩返しで……","translation":"不，可是，这本来就是我的报恩……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:58","scenario_id":58,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"ロズワール","text":"まあまあ、落ち着きたまーぇよ。君の恩返しにエミリア様は心当たりがない。それに、だ","translation":"好了好了，冷静一下～。你说的报恩，爱蜜莉雅大人并无印象。再者，","model":"roswaal01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:59","scenario_id":59,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"ロズワール","text":"仮に心当たりがあったとしても、何らかの\n形で報いなくてはならない功績だよ。\nエミリア様の後見人である私にとってもね","translation":"即使她有印象，这份功劳，也必须以某种形式回报。对身为爱蜜莉雅大人监护人的我而言，也一样。","model":"roswaal01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:60","scenario_id":60,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"エミリア","text":"ロズワールの言う通りよ。私からしてあげられることなんてあんまりないけど、何かあるなら言って？","translation":"罗兹瓦尔说得对。我能做的事不多，不过，如果有什么想要的，就告诉我吧？","model":"emilia01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:61","scenario_id":61,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"エミリア","text":"私から、ロズワールにちゃんとお願いしてみるから","translation":"我会好好拜托罗兹瓦尔的。","model":"emilia01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:62","scenario_id":62,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"スバル","text":"徽章の恩返し、か。だったら、俺の答えは……","translation":"归还徽章的谢礼啊。那么，我的答案是……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:63","scenario_id":63,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"スバル","text":"俺の答えは一つ！ オンリーワン！","translation":"我的答案只有一个！独一无二！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:64","scenario_id":64,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"ロズワール","text":"ほーお、面白い","translation":"哦～有意思。","model":"roswaal01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:65","scenario_id":65,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"スバル","text":"はっきり言って、仕事は未熟だ！\n庭いじりと、せいぜい手芸と裁縫、\n他は勉強させてもらうことになる！","translation":"说实话，我工作能力还不成熟！只会园艺，再就是手工和缝纫，其他的都得从头学起！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"mus