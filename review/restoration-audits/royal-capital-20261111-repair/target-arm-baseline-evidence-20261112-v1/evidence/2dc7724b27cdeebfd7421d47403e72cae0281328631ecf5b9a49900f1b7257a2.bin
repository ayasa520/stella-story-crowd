","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg027b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040036:14","scenario_id":14,"scene_id":"scene:10040036","kind":"card","title_mode":"","speaker":"ヴィルヘルム","text":"殺し屋、ですか。それは穏やかな話ではありませんな","translation":"杀手，是吗。那可不是小事。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg027b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040036:15","scenario_id":15,"scene_id":"scene:10040036","kind":"card","title_mode":"","speaker":"スバル","text":"その女がきたら、関わった奴はみんな殺されちまうかもしれねえんだ","translation":"那个女人来了以后，所有相关的人，可能都会被杀掉。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg027b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040036:16","scenario_id":16,"scene_id":"scene:10040036","kind":"card","title_mode":"","speaker":"？？？","text":"殺されるだぁ？","translation":"被杀掉？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg027b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040036:17","scenario_id":17,"scene_id":"scene:10040036","kind":"card","title_mode":"","speaker":"フェルト","text":"おいおい……人が到着するなり、ずいぶんと物騒な話してるじゃね一か","translation":"喂喂……我才刚到，你们就在谈这么危险的事啊。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg027b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040036:18","scenario_id":18,"scene_id":"scene:10040036","kind":"card","title_mode":"","speaker":"ロム爺","text":"おお、きたかフェルト。\nお前さんを待っている間に、\n珍妙な客どもが押しかけてきおってな","translation":"哦，来了，菲鲁特。等你的时候，来了一群古怪的客人。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg027b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040036:19","scenario_id":19,"scene_id":"scene:10040036","kind":"card","title_mode":"","speaker":"フェルト","text":"外で騒いでたから、聞こえてたぜ。\n殺し屋って、何の話――","translation":"你们在外面吵，我都听见了。杀手是怎么回——","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"comma