scene_id":"scene:10040023","kind":"card","title_mode":"","speaker":"フェルト","text":"ちっ、このメイドが魔法使いってのは聞いてね一ぞ……","translation":"啧，没人告诉我，这女仆是魔法使……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg040b_felthouse","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040023:36","scenario_id":36,"scene_id":"scene:10040023","kind":"card","title_mode":"","speaker":"フェルト","text":"遠くから魔法でバシバシって、卑怯だと思わね一のか！","translation":"躲得老远，用魔法不停地打，你不觉得卑鄙吗！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg040b_felthouse","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040023:37","scenario_id":37,"scene_id":"scene:10040023","kind":"card","title_mode":"","speaker":"ラム","text":"卑怯？笑わせないで。これは、天罰よ","translation":"卑鄙？别逗我笑了。这是天罚。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg040b_felthouse","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040023:38","scenario_id":38,"scene_id":"scene:10040023","kind":"card","title_mode":"","speaker":"スバル","text":"天罰とまで言う！？","translation":"居然都说成天罚了！？","mo