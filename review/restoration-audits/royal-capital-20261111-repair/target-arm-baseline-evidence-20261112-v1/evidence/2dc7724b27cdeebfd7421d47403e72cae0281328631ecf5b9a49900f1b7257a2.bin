"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg103c_forest","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10200007:7","scenario_id":7,"scene_id":"scene:10200007","kind":"card","title_mode":"","speaker":"ヴィルヘルム","text":"我々と共にいる間も、彼の目はどことなく遠くを見ているようでもありましたし","translation":"与我们一同生活时，他的目光，也似乎始终望着远方。","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg103c_forest","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10200007:8","scenario_id":8,"scene_id":"scene:10200007","kind":"card","title_mode":"","speaker":"フェリス","text":"ふーんだ。\nスバルきゅんなんか、あの曲者の辺境伯に\nあれこれ振り回されちゃえばいいんだ","translation":"哼。小昴那家伙，干脆就被那个难缠的边境伯，耍得团团转好了。","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg103c_forest","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10200007:9","scenario_id":9,"scene_id":"scene:10200007","kind":"card","title_mode":"","speaker":"クルシュ","text":"ずいぶんとご機嫌斜めだな。やけにナツキ・スバルに噛みつく","translation":"心情很差啊。对菜月昴，分外不饶人。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg103c_forest","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10200007:10","scenario_id":10,"scene_id":"scene:10200007","kind":"card","title_mode":"","speaker":"フェリス","text":"だってだって、言いましたけど、フェリちゃん、二度も命を助けたんですよ？","translation":"因为，因为，不是说了吗，菲利酱救了他两次命呢。","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg103c_forest","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10200007:11","scenario_id":11,"scene_id":"scene:10200007","kind":"card","title_mode":"","speaker":"フェリス","text":"にゃのに、メイザース辺境伯にボロ雑巾\nみたいに使い捨てられて野垂れ死にとか、\nフェリちゃんの献身が浮かばれませんもん！","translation":"要是他被梅札斯边境伯当作破抹布一样用完就扔，死在路边，菲利酱的付出，可就白费了！","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg103c_forest","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10200007:12","scenario_id":12,"scene_id":"scene:10200007","kind":"card","title_mode":"","speaker":"フェリス","text":"だから、スバルきゅんにはしっかり生きて、生き抜いてほしいんです","translation":"所以，我希望小昴能好好活着，一直活下去。","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times"