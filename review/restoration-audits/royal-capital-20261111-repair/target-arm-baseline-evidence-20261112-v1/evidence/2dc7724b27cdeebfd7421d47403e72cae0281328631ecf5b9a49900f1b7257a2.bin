"face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122c_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:30","scenario_id":30,"scene_id":"scene:10170003","kind":"card","title_mode":"","speaker":"フェリス","text":"つまり、クルシュ様に嘘は通用しないの。\nスバルきゅんの強がりもお見通しなわけ","translation":"也就是说，谎言对库珥修大人无效。小昴的逞强，早就被看穿了。","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122c_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:31","scenario_id":31,"scene_id":"scene:10170003","kind":"card","title_mode":"","speaker":"スバル","text":"ぐ、う","translation":"唔，呃……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122c_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:32","scenario_id":32,"scene_id":"scene:10170003","kind":"card","title_mode":"","speaker":"ヴィルヘルム","text":"スバル殿、話されてはいかがですか？私たちはあなたの敵ではありません","translation":"昴阁下，不妨说出来吧。我们并不是您的敌人。","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122c_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:33","scenario_id":33,"scene_id":"scene:10170003","kind":"card","title_mode":"","speaker":"スバル","text":"わかってる……わかってるよ！でも、言っただろ？迷惑をかけるんだ！俺がここにいたら、迷惑を…","translation":"我知道……我知道啊！可是，不是说了吗？会给你们添麻烦！我待在这里，会添麻烦……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122c_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:34","scenario_id":34,"scene_id":"scene:10170003","kind":"card","title_mode":"","speaker":"クルシュ","text":"ならば、共に打開策を練ってはどうだ。\nこう言ってはなんだが、\n当家の力はちょっとしたものだぞ","translation":"那便一同商讨解决之策，如何？虽说这话有些自夸，但本家的力量，也并非微不足道。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122c_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:35","scenario_id":35,"scene_id":"scene:10170003","kind":"card","title_mode":"","speaker":"クルシュ","text":"卿が抱える問題を解決する術も、私たちと協力すれば見つかるかもしれん","translation":"与我们合作，或许就能找到解决卿所面临问题的办法。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","