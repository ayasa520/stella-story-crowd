"bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122c_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:5","scenario_id":5,"scene_id":"scene:10170003","kind":"card","title_mode":"","speaker":"スバル","text":"置手紙の字も見様見真似だし、ちゃんと感謝が伝わったらいいんだが……","translation":"信上的字也是照猫画虎写的，希望能好好传达我的谢意……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122c_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:6","scenario_id":6,"scene_id":"scene:10170003","kind":"card","title_mode":"","speaker":"スバル","text":"ん、花壇か","translation":"嗯，是花坛啊。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122c_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:7","scenario_id":7,"scene_id":"scene:10170003","kind":"card","title_mode":"","speaker":"スバル","text":"うんうん、いい感じに芽吹いてるな。ここからもうちょっと背が伸びたら、蕾を付けて、花開いて……か","translation":"嗯嗯，芽长得不错。再长高一点，就会结苞，然后开花……是吧。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emis