otions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg134a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020034:34","scenario_id":34,"scene_id":"scene:10020034","kind":"card","title_mode":"","speaker":"リカード","text":"よし、わかった。\nここで会ったのも何かの縁や。\nその盗品蔵までワイが付き合ったる！","translation":"好，我明白了！在这里遇见也是缘分。我陪你去那个赃物库！","model":"ricardo01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg134a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020034:35","scenario_id":35,"scene_id":"scene:10020034","kind":"card","title_mode":"","speaker":"スバル","text":"――っ！ ホントか？\nすげえ助かる！\n下手すると荒事になりかねなかったんだ","translation":"——！真的吗？真是帮大忙了！情况不好的话，说不定会打起来。","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg134a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020034:36","scenario_id":36,"scene_id":"scene:10020034","kind":"card","title_mode":"","speaker":"リカード","text":"ますます、兄ちゃん一人やったら\nあかんかったやないか！","translation":"那更不能让你一个人去了啊！","model":"ricardo01","body":"","face":"","extra_motions":[],"bank":"","cue":"","b