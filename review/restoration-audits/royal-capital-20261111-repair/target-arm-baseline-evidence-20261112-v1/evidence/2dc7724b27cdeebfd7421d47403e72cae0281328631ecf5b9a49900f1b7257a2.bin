ted":""},{"id":"10470046:5","scenario_id":5,"scene_id":"scene:10470046","kind":"card","title_mode":"","speaker":"リカード","text":"おっかない姉さんやな！そないな話に付き合うかい！","translation":"真是个可怕的女人！谁要陪你玩这种把戏！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10470046:6","scenario_id":6,"scene_id":"scene:10470046","kind":"text","title_mode":"","speaker":"","text":"軽口めいたものを交わしながら\n二人が打ち合うのは命懸けの攻撃だ。","translation":"两人像是互相调侃，招呼彼此的却是赌上性命的攻击。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10470046:7","scenario_id":7,"scene_id":"scene:10470046","kind":"text","title_mode":"","speaker":"","text":"素人では目で追えないような、\n超越者だけが繰り広げる神域の戦闘。\n――それが、交錯していた。","translation":"那是外行根本无法用双眼捕捉，唯有超越常人的强者才能涉足的战斗。两股力量，不断交错——","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10470046:8","scenario_id":8,"scene_id":"scene:1