esource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122a_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10150004:13","scenario_id":13,"scene_id":"scene:10150004","kind":"card","title_mode":"","speaker":"スバル","text":"うお、それはプレッシャーッスね。うし、頑張らせてもらいます","translation":"哦，这可真有压力啊。好，我会努力的。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122a_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10150004:14","scenario_id":14,"scene_id":"scene:10150004","kind":"card","title_mode":"","speaker":"スバル","text":"……あの、ヴィルヘルムさん？そんな見られてると、緊張するんですが","translation":"……那个，威尔海姆先生？您这么一直盯着，我有点紧张。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122a_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10150004:15","scenario_id":15,"scene_id":"scene:10150004","kind":"card","title_mode":"","speaker":"ヴィルヘルム","text":"おっと、これは失礼しました。つい、興味深くてですね","translation":"啊，失礼了。只是觉得很有意思，便不由自主……","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122a_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10150004:16","scenario_id":16,"scene_id":"scene:10150004","kind":"card","title_mode":"","speaker":"スバル","text":"興味深い？\nってことは、ヴィルヘルムさんも\n園芸に興味があるとか","translation":"很有意思？也就是说，威尔海姆先生对园艺也有兴趣？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122a_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10150004:17","scenario_id":17,"scene_id":"scene:10150004","kind":"card","title_mode":"","speaker":"フェリス","text":"やほー、スバルきゅん","translation":"嗨～小昴。","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122a_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10150004:18","scenario_id":18,"scene_id":"scene:10150004","kind":"card","title_mode":"","speaker":"フェリス","text":"聞いたよ~、花壇の世話だって？そんなに仕事したがりなんて、変な子","translation":"我听说啦，在照料花坛？居然这么想工作，真是个怪孩子。","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"s