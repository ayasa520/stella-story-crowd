tive_unsupported":""},{"id":"10020049:14","scenario_id":14,"scene_id":"scene:10020049","kind":"card","title_mode":"","speaker":"スバル","text":"そうね！ 俺が胴長短足だから\nちょうどいいね！ クソ、イケメンは\nジャージ着てもイケメンだな……！","translation":"是啊！我就是身长腿短，所以你穿得正好！可恶，帅哥就连穿运动服也这么帅……！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020049:15","scenario_id":15,"scene_id":"scene:10020049","kind":"card","title_mode":"","speaker":"ユリウス","text":"こうなると、名前も隠すべきだろう。今から私はユーリと、そう呼んでくれ","translation":"既然如此，名字也该隐瞒一下。从现在起，请叫我尤里。","model":"julius_jersey01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020049:16","scenario_id":16,"scene_id":"scene:10020049","kind":"card","title_mode":"","speaker":"スバル","text":"案外ノリノリなとこ悪いけど、とつとといくぞ、ユーリ!","translation":"你还真是乐在其中，不过不好意思，赶紧走吧，尤里！","model":"subaru_tshirt01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupp