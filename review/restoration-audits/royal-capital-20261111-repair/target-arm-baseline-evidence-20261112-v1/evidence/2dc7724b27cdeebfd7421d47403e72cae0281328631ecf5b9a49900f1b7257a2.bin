"――。まあ、いいわ。\nそれで、質問には答えてもらえる？\nあなた、ここの人たちとお知り合い？","translation":"——。算了。那么，能回答我的问题了吗？你认识这里的人吗？","model":"elsa01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg024a_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10160009:21","scenario_id":21,"scene_id":"scene:10160009","kind":"card","title_mode":"","speaker":"スバル","text":"い、いや！全然！空き家を覗いただけ！爺さんも女の子も知らねえよ！","translation":"不、不认识！完全不认识！我只是进空屋看看！什么老爷子和女孩子，我都不知道！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg024a_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10160009:22","scenario_id":22,"scene_id":"scene:10160009","kind":"card","title_mode":"","speaker":"スバル","text":"悪いけど、俺、急いでんだ。こ、これで失礼するぜ……","translation":"抱歉，我还赶时间。那、那我先走了……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg024a_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10160009:23","scenario_id":23,"scene_id":"scene:10160009","kind":"card","title_mode":"","speaker":"エルザ","text":"あら、つれないこと。それにしても一","translation":"哎呀，真冷淡。不过——","model":"elsa01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg024a_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10160009:24","scenario_id":24,"scene_id":"scene:10160009","kind":"card","title_mode":"","speaker":"エルザ","text":"知らないのなら、どうしてお爺さんと女の子のこと、言われなくてもわかったのかしら、ね？","translation":"既然不认识，为什么没人提起，你就知道这里有位老爷爷和一个女孩子呢？","model":"elsa01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg024a_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10160010:1","scenario_id":1,"scene_id":"scene:10160010","kind":"title","title_mode":"scene","speaker":"","text":"花畑","translation":"花田","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"","source_scenario_id":null},"native_video":null,"native_unsupported":""},{"id":"10160010:2","scenario_id":2,"scene_id":"scene:10160010","kind":"text","title_mode":"","speaker":"","text":"――エルザと遭遇し恐怖を覚えたスバルは、\n逃げるように走り去る。がむしゃらに走った\n先で広がっていたのは、素朴な花畑だった。","translation":"——遭遇艾尔莎后，昴满心恐惧，逃也似的跑开。拼命奔跑后，展现在他面前的是一片朴素的花田。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"bg/bg0