":null,"native_unsupported":""},{"id":"10040042:15","scenario_id":15,"scene_id":"scene:10040042","kind":"card","title_mode":"","speaker":"リカード","text":"なんや急に？えらい気合い入った言い方やけど、ワイらのカが必要なんか？","translation":"怎么突然这么郑重？这气势十足的说法，是需要俺们帮忙？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg069a_fountain","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040042:16","scenario_id":16,"scene_id":"scene:10040042","kind":"card","title_mode":"","speaker":"リカード","text":"とりあえず、話は聞こうやないか。\n協力するかはそれからの話や","translation":"总之，先听听吧。帮不帮忙，之后再说。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg069a_fountain","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040042:17","scenario_id":17,"scene_id":"scene:10040042","kind":"card","title_mode":"","speaker":"スバル","text":"ああ、時間がないから手短に話す。\n実はだな――、","translation":"嗯，时间不多，我就长话短说。其实——","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg069a_fountain","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040042:18","scenario_id":18,"scene_id":"scene:10040042","kind":"card","title_mode":"","speaker":"リカード","text":"つまり、兄ちゃんは探し物の真っ最中。で、物騒なとこにいく予定やから、ワイらに一緒にきてほしいと","translation":"也就是说，小哥正在找东西。接下来要去个危险的地方，所以，希望俺们一起去。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg069a_fountain","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040042:19","scenario_id":19,"scene_id":"scene:10040042","kind":"card","title_mode":"","speaker":"スバル","text":"ああ、そういうことなんだ","translation":"嗯，就是这么回事。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg069a_fountain","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040042:20","scenario_id":20,"scene_id":"scene:10040042","kind":"card","title_mode":"","speaker":"リカード","text":"なるほどなあ……とはいえ、ワイらも本業は傭兵や。本当なら銭払うてもらわんとやが……","translation":"原来如此……不过，俺们也是正经佣兵。照理说，可得收钱……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg069a_fountain","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040042:21","scenario_id":21,"scene_id":"scene:10040042","kind":"card","title_mode":"","speaker":"スバル","text":"――――。","tr