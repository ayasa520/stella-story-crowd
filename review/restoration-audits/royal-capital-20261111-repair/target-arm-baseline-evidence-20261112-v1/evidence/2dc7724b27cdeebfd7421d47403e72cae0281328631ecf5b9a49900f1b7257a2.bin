ve_unsupported":""},{"id":"10020035:38","scenario_id":38,"scene_id":"scene:10020035","kind":"card","title_mode":"","speaker":"スバル","text":"妙なこと言ったのと、だんまりしてたのは悪かった。爺さん、ここには探し物しにきたんだ","translation":"说了奇怪的话，又一直不吭声，是我不好。老爷子，我是来这里找东西的。","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg027a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020035:39","scenario_id":39,"scene_id":"scene:10020035","kind":"card","title_mode":"","speaker":"巨大な体躯の老人","text":"探し物、じゃと？ここは盗品蔵じゃぞ。お前さん、盗品に興味でもあるのか？","translation":"找东西？这里可是赃物库。你对赃物感兴趣？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg027a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020035:40","scenario_id":40,"scene_id":"scene:10020035","kind":"card","title_mode":"","speaker":"巨大な体躯の老人","text":"まさか、盗まれた物を返せとでも？それならお門違いってもんじゃぞ","translation":"难不成想叫老夫把被偷的东西还回去？那你可找错地方了。","model":"rom01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg027a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"100200