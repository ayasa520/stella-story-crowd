","resource":"bg/bg001_black","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170001:21","scenario_id":21,"scene_id":"scene:10170001","kind":"card","title_mode":"","speaker":"スバル","text":"―――。","translation":"——。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg001_black","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170001:22","scenario_id":22,"scene_id":"scene:10170001","kind":"card","title_mode":"","speaker":"スバル","text":"(……なんだ?何が起きた?買い出しの最中?俺たちが?だって、そんなの、昨日の話だろ!?)","translation":"（……怎么回事？发生了什么？正在采购？我们？可是，那不是昨天的事吗！？）","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg001_black","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170001:23","scenario_id":23,"scene_id":"scene:10170001","kind":"card","title_mode":"","speaker":"スバル","text":"（けど、この貧民街の花畑も、\nヴィルヘルムさんの態度も、本物だ。\n昨日と同じシチュエーション……）","translation":"（但是，贫民区的这片花田，还有威尔海姆先生的态度，都是真的。和昨天一模一样的情境……）","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg001_black","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170001:24","scenario_id":24,"scene_id":"scene:10170001","kind":"card","title_mode":"","speaker":"スバル","text":"（なんで、どうして、そんなことになる？そんな可能性が、あるとしたら……)","translation":"（为什么，怎么会这样？如果真有那种可能的话……）","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg001_black","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170001:25","scenario_id":25,"scene_id":"scene:10170001","kind":"card","title_mode":"","speaker":"スバル","text":"まさ、か……","translation":"难道……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg001_black","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170001:26","scenario_id":26,"scene_id":"scene:10170001","kind":"card","title_mode":"","speaker":"ヴィルヘルム","text":"スバル殿、いかがですか？そろそろ、気持ちは落ち着かれましたか？","translation":"昴阁下，感觉如何？现在，心情平静一些了吗？","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg001_black","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170001:27","scenario_id":27,"scene_id":"scene:10170001","kind":"card","title_mode":"","speaker":"ヴィルヘルム","text":"いえ、落ち着かれたならよかった。何事もないのであれば、私も安心です","translation":"不，能平静下来就好。若是没有什么事，我也放心了。","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg001_black","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170001:28","scenario_id":28,"scene_id":"scene:10170001","kind":"card","title_mode":"","speaker":"ヴィルヘルム","text":"では、立てますかな？寄り道が長引くと、フェリスの機嫌を損ねてしまいますから","translation":"那么，能站起来吗？绕路太久，菲利丝可要不高兴了。","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg001_black","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170001:29","scenario_id":29,"scene_id":"scene:10170001","kind":"card","title_mode":"","speaker":"スバル","text":"ああっと、そうですね……戻りましょう。屋敷に","translation":"啊，对啊……我们回去吧。回宅邸。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg001_black","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170001:30","scenario_id":30,"scene_id":"scene:10170001","kind":"card","title_mode":"","speaker":"ヴィルヘルム","text":"――？\nええ、そうしましょう","translation":"——？嗯，回去吧。","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg001_black","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170002:1","scenario_id":1,"scene_id":"scene:10170002","kind":"title","title_mode":"scene","speaker":"","text":"決断","translation":"决断","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"","source_scenario_id":null},"native_video":null,"native_unsupported":""},{"id":"10170002:2","scenario_id":2,"scene_id":"scene:10170002","kind":"text","title_mode":"","speaker":"","text":"――スバルは自分の身に起こっていることに\nついて、一つの結論を下す。そして、これか\nらの対策を考える。","translation":"——对于发生在自己身上的事，昴得出了一个结论。随后，他开始思考接下来的对策。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"bg/bg076b_roswaal","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170002:3","scenario_id":3,"scene_id":"scene:10170002","kind":"text","title_mode":"","speaker":"","text":"――クルシュ邸の客室・夕刻","translation":"——库珥修宅邸客房·傍晚","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170002:4","scenario_id":4,"scene_id":"scene:10170002","kind":"card","title_mode":"","speaker":"スバル","text":"……フェリスは、無事だった。\n帰りが遅くなったせいで、\nちょっと小言言われたが、それだけだ","translation":"……菲利丝平安无事。因为回来得晚了，被他念叨了几句，仅此而已。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170002:5","scenario_id":5,"scene_id":"scene:10170002","kind":"card","title_mode":"","speaker":"スバル","text":"あいつは何も知らなかった。いや、\nあいつだけじゃない。ヴィルヘルムさんも、\nクルシュさんも何も知らない","translation":"他什么都不知道。不，不只是他。威尔海姆先生和库珥修小姐，也都什么都不知道。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170002:6","scenario_id":6,"scene_id":"scene:10170002","kind":"card","title_mode":"","speaker":"スバル","text":"三人にとって、俺が見たのは明日の出来事なんだ","translation":"对他们三人而言，我看见的那些，都是明天才会发生的事。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170002:7","scenario_id":7,"scene_id":"scene:10170002","kind":"card","title_mode":"","speaker":"スバル","text":"明日、俺はフェリスと一緒に、\n竜車でエミリアの屋敷に向かうことになる。\nそして、そこであの女、エルザに……","translation":"明天，我会和菲利丝一起，乘龙车去爱蜜莉雅的宅邸。然后在那里，被那个女人，艾尔莎……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170002:8","scenario_id":8,"scene_id":"scene:10170002","kind":"card","title_mode":"","speaker":"スバル","text":"つまり、これはあれだ。タイムリープ","translation":"也就是说，这是那个吧。时间跳跃。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170002:9","scenario_id":9,"scene_id":"scene:10170002","kind":"card","title_mode":"","speaker":"スバル","text":"俺は死んで、それから死ぬ前に時間を遡ってる。名付けて、『死に戻り』","translation":"我死了，然后回溯到死前的时间。就叫它，『死亡回归』。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170002:10","scenario_id":10,"scene_id":"scene:10170002","kind":"card","title_mode":"","speaker":"スバル","text":"……馬鹿か俺は。いや、馬鹿だ俺は。気付くのが遅すぎる","translation":"……我是白痴吗。不，我就是白痴。也发现得太晚了。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170002:11","scenario_id":11,"scene_id":"scene:10170002","kind":"card","title_mode":"","speaker":"スバル","text":"前に二回、腹を斬られて痛い思いをしたのは夢でも何でもなく、現実だった。俺は死んで、『死に戻り』したんだ","translation":"之前两次，被剖开肚子，痛不欲生，那既不是梦，也不是什么幻觉，而是现实。我死了，然后『死亡回归』了。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170002:12","scenario_id":12,"scene_id":"scene:10170002","kind":"card","title_mode":"","speaker":"スバル","text":"だから、周りと意見がちぐはぐだった。\nフェルトやロム爺とも、\nそれこそ俺を殺したエルザとも……","translation":"所以，我才和周围的人说不到一块。不管是菲鲁特、罗姆爷，甚至，杀了我的艾尔莎……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170002:13","scenario_id":13,"scene_id":"scene:10170002","kind":"card","title_mode":"","speaker":"スバル","text":"―――。","translation":"——。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170002:14","scenario_id":14,"scene_id":"scene:10170002","kind":"card","title_mode":"","speaker":"スバル","text":"もう、こいつは拾っちまった。拾って、盗品蔵でエルザと出くわした","translation":"我已经捡到这东西了。捡到之后，又在赃物库撞见了艾尔莎。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170002:15","scenario_id":15,"scene_id":"scene:10170002","kind":"card","title_mode":"","speaker":"スバル","text":"あいつ、竜車で言ってたな。盗品蔵で俺と出くわして、そこから俺に疑いをかけてたって……","translation":"那家伙在龙车旁说过吧。她在赃物库碰见我，从那时起，就怀疑我了……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170002:16","scenario_id":16,"scene_id":"scene:10170002","kind":"card","title_mode":"","speaker":"スバル","text":"ってことは、もう、俺はあいつにターゲット\nとしてロックオンされちまったあとだ。\nあいつは、この徽章を奪いにくる","translation":"也就是说，我已经被她锁定为目标了。她会来，抢走这枚徽章。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170002:17","scenario_id":17,"scene_id":"scene:10170002","kind":"card","title_mode":"","speaker":"スバル","text":"……フェリス、痛かったよな。俺も、お前の気持ちは本気でわかるぜ","translation":"……菲利丝，很疼吧。你的感受，我是真的明白。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170002:18","scenario_id":18,"scene_id":"scene:10170002","kind":"card","title_mode":"","speaker":"スバル","text":"エルザは、あの女はマジでヤバい。まともにやり合っちゃ勝てる相手じゃない。だから","translation":"艾尔莎，那个女人，真的太危险了。正面交手，绝不可能赢。所以——","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170002:19","scenario_id":19,"scene_id":"scene:10170002","kind":"card","title_mode":"","speaker":"スバル","text":"……これ以上、この家の人たちに迷惑はかけられない","translation":"……不能再给这家人添更多麻烦了。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170002:20","scenario_id":20,"scene_id":"scene:10170002","kind":"card","title_mode":"","speaker":"スバル","text":"潮時、だよな。\nちょっと、良くしてもらいすぎちまった","translation":"该走了，是吧。他们，对我实在是太好了。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170002:21","scenario_id":21,"scene_id":"scene:10170002","kind":"card","title_mode":"","speaker":"スバル","text":"……今までありがとう。みんな","translation":"……一直以来，谢谢大家。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:1","scenario_id":1,"scene_id":"scene:10170003","kind":"title","title_mode":"s