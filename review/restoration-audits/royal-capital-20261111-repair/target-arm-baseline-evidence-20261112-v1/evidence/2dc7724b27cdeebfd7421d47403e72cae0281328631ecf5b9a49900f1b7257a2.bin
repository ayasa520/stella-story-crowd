und":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040022:16","scenario_id":16,"scene_id":"scene:10040022","kind":"card","title_mode":"","speaker":"ラム","text":"なるほど、話はわかったわ。とにかく、なくなった徽章を探して、この王都をうろついているわけね","translation":"原来如此，我明白了。也就是说，她为了寻找失窃的徽章，在王都里四处走动。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040022:17","scenario_id":17,"scene_id":"scene:10040022","kind":"card","title_mode":"","speaker":"ラム","text":"それなら、すぐに動かないと……","translation":"那就必须立刻行动……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040022:18","scenario_id":18,"scene_id":"scene:10040022","kind":"card","title_mode":"","speaker":"スバル","text":"まあ、待て！それだけじゃない!その徽章なんだが、どこにあるのか俺には心当たりがあるんだ！","translation":"先等等！还不止这些！那枚徽章在哪里，我有线索！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040022:19","scenario_id":19,"scene_id":"scene:10040022","kind":"card","title_mode":"","speaker":"ラム","text":"……本気で言ってるの？あまりにも話がうますぎると思わない？","translation":"……你是认真的？不觉得事情顺利得过头了吗？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040022:20","scenario_id":20,"scene_id":"scene:10040022","kind":"card","title_mode":"","speaker":"スバル","text":"疑われるのはわかるが、わざわざ俺が徽章だのなんだのって話を振りまいてまで嘘つく理由があるか？","translation":"我明白你会怀疑，可我有必要到处宣扬徽章的事，只为了撒谎吗？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040022:21","scenario_id":21,"scene_id":"scene:10040022","kind":"card","title_mode":"","speaker":"ラム","text":"――――。","translation":"——。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040022:22","scenario_id":22,"scene_id":"scene:10040022","kind":"card","title_mode":"","speaker":"スバル","text":"こんなこと言うのもなんだけど、仮に俺が悪者だったとしても、ラムにもあの子にも手も足も出ねえよ","translation":"虽然这么说有点那什么，就算我是坏人，也根本打不过你和她。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040022:23","scenario_id":23,"scene_id":"scene:10040022","kind":"card","title_mode":"","speaker":"スバル","text":"俺がさっきのチンピラよりも強そうに見えるか？","translation":"你看我，像是比刚才那些混混还厉害吗？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040022:24","scenario_id":24,"scene_id":"scene:10040022","kind":"card","title_mode":"","speaker":"ラム","text":"……いいえ。ないわね。\n吹けば飛ぶような路傍の石ころだわ","translation":"……不像。完全不像。就像路边一块石子，吹口气就能吹跑。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040022:25","scenario_id":25,"scene_id":"scene:10040022","kind":"card","title_mode":"","speaker":"スバル","text":"そこまで言う!？ま、まあ、とにかくそうなんだよ","translation":"用得着说到这个地步吗！？算、算了，总之就是这么回事。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040022:26","scenario_id":26,"scene_id":"scene:10040022","kind":"card","title_mode":"","speaker":"ラム","text":"――。いいわ。話を聞いてあげる。\n確かに、こちらを謀ろうとしているにしては\nお粗末すぎるもの","translation":"——好吧，我听你说。的确，就算想骗我们，这也太粗糙了。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040022:27","scenario_id":27,"scene_id":"scene:10040022","kind":"card","title_mode":"","speaker":"スバル","text":"さいですか……。いや、わかってくれて何よりだよ","translation":"是这样啊……不，你能理解就好。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040022:28","scenario_id":28,"scene_id":"scene:10040022","kind":"card","title_mode":"","speaker":"スバル","text":"そしたら、心当たりに案内する。ああ、俺の名前はナツキ・スバルだ","translation":"那我带你去有线索的地方。啊，我叫菜月昴。","mode