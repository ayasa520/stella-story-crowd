":{"mode":"native_array","resource":"bg/bg057a1_cafeteria","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:33","scenario_id":33,"scene_id":"scene:10130004","kind":"card","title_mode":"","speaker":"アナスタシア","text":"こーら、そんな落ち込まんの。大丈夫、ナツキくんの選択は正解や","translation":"好啦，别那么沮丧。没事，你的选择是正确的。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg057a1_cafeteria","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:34","scenario_id":34,"scene_id":"scene:10130004","kind":"card","title_mode":"","speaker":"アナスタシア","text":"ナツキくんがウチを選んでくれて、\n自分の持てる一番の手札も切って\nくれたんやから、ウチもそれに応えんとね","translation":"你选了我，还打出了手里最好的牌，我自然也得回应你。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg057a1_cafeteria","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:35","scenario_id":35,"scene_id":"scene:10130004","kind":"card","title_mode":"","speaker":"スバル","text":"え？でも、交渉は無理だって……","translation":"诶？可你说没法谈……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg057a1_cafeteria","source_scenario_id