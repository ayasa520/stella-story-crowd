":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122a_crusch","source_scenario_id":17},"native_video":null,"native_unsupported":""},{"id":"10150003:22","scenario_id":22,"scene_id":"scene:10150003","kind":"card","title_mode":"","speaker":"ヴィル爺","text":"む、フェリスですか。それと、あなたは路地で倒れていた御仁","translation":"嗯，是菲利丝啊。还有，你是倒在小巷里的那位。","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122a_crusch","source_scenario_id":17},"native_video":null,"native_unsupported":""},{"id":"10150003:23","scenario_id":23,"scene_id":"scene:10150003","kind":"card","title_mode":"","speaker":"スバル","text":"あ、ナツキ・スバルっていいます","translation":"啊，我叫菜月昴。","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122a_crusch","source_scenario_id":17},"native_video":null,"native_unsupported":""},{"id":"10150003:24","scenario_id":24,"scene_id":"scene:10150003","kind":"card","title_mode":"","speaker":"ヴィルヘルム","text":"お加減が良くなられたようで何よりです。私は、この屋敷でご厄介になっている、ヴィルヘルムと申します","translation":"看来您身体好多了，真是再好不过。我叫威尔海姆，承蒙关照，住在这座宅邸里。","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","charac