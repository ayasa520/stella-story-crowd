騒いでいたわけを","translation":"说说吧，为什么在大街上闹得那么大声？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040022:4","scenario_id":4,"scene_id":"scene:10040022","kind":"card","title_mode":"","speaker":"スバル","text":"あ、ああ、やっぱり見てたのか","translation":"啊，嗯，果然看见了啊。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040022:5","scenario_id":5,"scene_id":"scene:10040022","kind":"card","title_mode":"","speaker":"ラム","text":"あれだけ騒いでいれば当然ね。ただ、こっちにも事情があるのよ","translation":"闹成那样，当然看得见。不过，我这边也有些情况。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040022:6","scenario_id":6,"scene_id":"scene:10040022","kind":"card","title_mode":"","speaker":"ラム","text":"それで人目につかない場所で話を聞こうと思っていたら、あのゴロツキたちだわ","translation":"本想找个不引人注意的地方问话，结果却碰上那几个混混。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040022:7","scenario_id":7,"scene_id":"scene:10040022","kind":"card","title_mode":"","speaker":"ラム","text":"まったく、余計な労力を使わせて。これで大した話が聞けなかったら、それなりの覚悟をしておきなさい","translation":"真是的，害我多费力气。要是听不到什么有价值的话，你最好做好觉悟。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040022:8","scenario_id":8,"scene_id":"scene:10040022","kind":"card","title_mode":"","speaker":"スバル","text":"それも理不尽な話だと思うが、たぶん、お前の聞きたい話はできるはずだ","translation":"虽然这也挺不讲理的，不过，我应该能告诉你想听的事。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040022:9","scenario_id":9,"scene_id":"scene:10040022","kind":"card","title_mode":"","speaker":"スバル","text":"俺とお前の探し人は同じはず。俺は、その子に恩を返したいんだよ！","translation":"你和我要找的应该是同一个人。我想报答她的恩情！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040022:10","scenario_id":10,"scene_id":"scene:10040022","kind":"card","title_mode":"","speaker":"ラム","text":"……続けなさい。どういうことなの？","translation":"……说下去。怎么回事？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040022:11","scenario_id":11,"scene_id":"scene:10040022","kind":"card","title_mode":"","speaker":"スバル","text":"話の流れは簡単だ。その子にも、お前みたいに路地で絡まれてるところを助けられたんだ","translation":"经过很简单。和你一样，她也救过在巷子里被人纠缠的我。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg010a_backstreet","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040022:12","scenario_id":12,"scene_id":"scene:10040022","kind":"card","title_mode":"","speaker":"スバル","text":"そのとき、あの子が探し物……。大事な徽章を盗まれたって話を聞いて","translation":"那时我听说，她在找东西……一枚很重要的徽章被偷了。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":[""