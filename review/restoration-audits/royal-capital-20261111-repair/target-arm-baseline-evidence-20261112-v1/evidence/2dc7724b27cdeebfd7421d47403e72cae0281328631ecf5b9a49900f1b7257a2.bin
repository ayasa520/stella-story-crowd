ovie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg023b_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10450055:8","scenario_id":8,"scene_id":"scene:10450055","kind":"card","title_mode":"","speaker":"ロム爺","text":"……なんじゃ、その顔は。あの若造共を残してきたのが、そんなに気に入らんのか","translation":"……怎么这副表情？把那两个年轻人留在那里，让你这么不痛快？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg023b_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10450055:9","scenario_id":9,"scene_id":"scene:10450055","kind":"card","title_mode":"","speaker":"フェルト","text":"ったりめーだろ。全部、アタシが\nやらかしたことだぜ。その尻拭いを、\nよりによって騎士に押し付けてんだ","translation":"那还用说。全是我惹出来的事，结果，却偏偏丢给骑士来收拾烂摊子。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg023b_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10450055:10","scenario_id":10,"scene_id":"scene:10450055","kind":"card","title_mode":"","speaker":"フェルト","text":"気に入らねーよ。何もかも……\n気に入らねー……","translation":"就是不痛快。一切，都让我不痛快……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":