"face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10110003:40","scenario_id":40,"scene_id":"scene:10110003","kind":"card","title_mode":"","speaker":"スバル","text":"いや、こういう場合、現代知識を活かして稼ぐってのがセオリーか？","translation":"不，这种时候，用现代知识赚钱才是常规操作吧？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10110003:41","scenario_id":41,"scene_id":"scene:10110003","kind":"card","title_mode":"","speaker":"スバル","text":"幸い、元手になりそうなものはある！\nあとは何で儲けるかだ","translation":"幸好，我还有能当本钱的东西！剩下的就是靠什么赚钱了。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10110003:42","scenario_id":42,"scene_id":"scene:10110003","kind":"card","title_mode":"","speaker":"スバル","text":"俺の知識にあって、実現は可能で、かつこの世界の人たちにも受け入れられそうなものか……","translation":"我知道的知识里，能做得出来、又能让这个世界的人接受的东西……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"