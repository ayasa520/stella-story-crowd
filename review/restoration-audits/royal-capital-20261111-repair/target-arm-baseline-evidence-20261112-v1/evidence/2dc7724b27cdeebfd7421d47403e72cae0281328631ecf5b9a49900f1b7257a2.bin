],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg081b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10200006:4","scenario_id":4,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"フェリス","text":"さ、ついたよ、スバルきゅん。\n愛しのお姫様のお屋敷にネ","translation":"好，到啦，小昴。你心爱的公主殿下的宅邸哦。","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg081b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10200006:5","scenario_id":5,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"スバル","text":"だ、だから違えっての！お前はここまできて、まだそんなことを……","translation":"所、所以说，不是那样！都到这里了，你居然还说这种话……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg081b_roswaal","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10200006:6","scenario_id":6,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"ヴィルヘルム","text":"では、ご挨拶に伺って参ります。こちらでしばしお待ちを","translation":"那么，我先去通报，请各位在此稍候。","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movi