g039a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040051:12","scenario_id":12,"scene_id":"scene:10040051","kind":"card","title_mode":"","speaker":"衛兵","text":"ユリウス殿が行かれるほどのことでは……。\nここは我々が！","translation":"还不至于让尤里乌斯阁下亲自出马……这里，就交给我们！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg039a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040051:13","scenario_id":13,"scene_id":"scene:10040051","kind":"card","title_mode":"","speaker":"ユリウス","text":"彼は私を頼ってきている。君たちは君たちの職務を果たしてくれ。必要があれば、必ず声をかける","translation":"他是来向我求助的。你们，便尽自己的职责吧。若有需要，我一定会叫上你们。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg039a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040051:14","scenario_id":14,"scene_id":"scene:10040051","kind":"card","title_mode":"","speaker":"衛兵","text":"はっ!","translation":"是！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg039a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040051:15","scenario_id":15,"scene_id":"scene:10040051","kind":"card","title_mode":"","speaker":"スバル","text":"さっすが騎士様だな、頼りになるぜ。早速だけど、ついてきてもらえるか？……つとその前に","translation":"不愧是骑士大人，真可靠。事不宜迟，能跟我走一趟吗？……不过，在那之前，","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg039a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040051:16","scenario_id":16,"scene_id":"scene:10040051","kind":"card","title_mode":"","speaker":"スバル","text":"その身なりじゃ、騎士だってバレバレだ。それで貧民街の連中に警戒されちゃ困る。俺の上着で誤魔化してくれ","translation":"你这身装扮，谁都看得出是骑士。要是因此让贫民区的人警觉，可就麻烦了。用我的外套遮掩一下吧。","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg039a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040051:17","scenario_id":17,"scene_id":"scene:10040051","kind":"card","title_mode":"","speaker":"ユリウス","text":"ふむ。珍しい服だ。興味深い。しばらく借り受けることにしよう","translation":"嗯，真少见的衣服，很有意思。那便暂借一阵吧。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg039a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040051:18","scenario_id":18,"scene_id":"scene:10040051","kind":"card","title_mode":"","speaker":"スバル","text":"あと、『最優の騎士』が本名じゃ目立ちすぎちまう。だから、ユーリって呼ばせてもらうぜ。それでいいよな？","translation":"还有，『最优的骑士』用本名，也太显眼了。所以，我就叫你尤里，没问题吧？","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg039a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040051:19","scenario_id":19,"scene_id":"scene:10040051","kind":"card","title_mode":"","speaker":"ユリウス","text":"そこまで考えているとは恐れ入るな。わかった。これから、私はただのユーリだ","translation":"竟考虑得如此周全，佩服。我明白了。从现在起，我便只是尤里。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg039a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040051:20","scenario_id":20,"scene_id":"scene:10040051","kind":"card","title_mode":"","speaker":"スバル","text":"それじゃついてきてくれ、ユーリ。詳しいことは歩きながら話そう","translation":"那么，跟我来，尤里。详细情况，路上再说吧。","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg039a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040052:1","scenario_id":1,"scene_id":"scene:10040052","kind":"title","title_mode":"scene","speaker":"","text":"生きていた蔵主","translation":"还活着的库主","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"","source_scenario_id":null},"native_video":null,"native_unsupported":""},{"id":"10040052:2","scenario_id":2,"scene_id":"scene:10040052","kind":"text","title_mode":"","speaker":"","text":"――盗品蔵に到着すると、やはり蔵主のロム\n爺は生きていた。スバルはフェルトを待って\n交渉しようと考える……","translation":"——抵达赃物库后，库主罗姆爷果然还活着。昴打算等菲鲁特到来，再展开交涉……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"bg/bg024a_slum","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg024a_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040052:3","scenario_id":3,"scene_id":"scene:10040052","kind":"text","title_mode":"","speaker":"","text":"――盗品蔵前・昼","translation":"——赃物库前·白天","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg024a_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040052:4","scenario_id":4,"scene_id":"scene:10040052","kind":"card","title_mode":"","speaker":"ユリウス","text":"なるほど……事情は理解した。話の通りならば、それは『腸狩り』のエルザだろう","translation":"原来如此……我明白了。若如你所言，那应该是『猎肠者』艾尔莎。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg024a_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040052:5","scenario_id":5,"scene_id":"scene:10040052","kind":"card","title_mode":"","speaker":"スバル","text":"『腸狩り』……改めて聞いても、物騒な異名だな……","translation":"『猎肠者』……再听一次，还是个凶险的名号啊……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg024a_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040052:6","scenario_id":6,"scene_id":"scene:10040052","kind":"card","title_mode":"","speaker":"ユリウス","text":"他者の腹を切り裂いて殺す。その殺人の手口から付いた異名だよ","translation":"剖开他人的腹部，取人性命。这个外号，正是来自她的杀人手法。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg024a_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040052:7","scenario_id":7,"scene_id":"scene:10040052","kind":"card","title_mode":"","speaker":"スバル","text":"ああ、恐ろしく腕の立つ女だったからな。人を殺すのを何とも思ってねえ","translation":"嗯，那女人的身手，可怕得很。杀人对她来说，根本不算什么。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg024a_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040052:8","scenario_id":8,"scene_id":"scene:10040052","kind":"card","title_mode":"","speaker":"ユリウス","text":"……不安は隠せないようだね","translation":"……看来，你还是掩不住不安啊。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg024a_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040052:9","scenario_id":9,"scene_id":"scene:10040052","kind":"card","title_mode":"","speaker":"スバル","text":"とんでもなくヤバい奴がいるところに、わざわざいくってんだから、当然だろ","translation":"明知道有个危险得不得了的家伙，还特意赶过去，当然会不安。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg024a_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040052:10","scenario_id":10,"scene_id":"scene:10040052","kind":"card","title_mode":"","speaker":"ユリウス","text":"だが、それを承知で、君は私を案内している。その行為は、素直に賞賛に値する","translation":"但即使明白这一点，你仍然带我前来。这种行为，本身便值得赞赏。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":