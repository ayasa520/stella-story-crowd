:"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg040b_felthouse","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040023:42","scenario_id":42,"scene_id":"scene:10040023","kind":"card","title_mode":"","speaker":"フェルト","text":"それを、はいそーですかなんて\n軽く手放せるもんかよ！","translation":"难道你说一句，我就乖乖轻易交出来吗！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg040b_felthouse","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040023:43","scenario_id":43,"scene_id":"scene:10040023","kind":"card","title_mode":"","speaker":"スバル","text":"おい、フェルト、悪いことは言わねえ。さっさと徽章を返しちまえ。ラムはやるって言ったことはやる女だぞ","translation":"喂，菲鲁特，我是为你好，赶紧把徽章还了吧。拉姆可是说到做到的女人。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg040b_felthouse","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040023:44","scenario_id":44,"scene_id":"scene:10040023","kind":"card","title_mode":"","speaker":"ラム","text":"バルス、勝手にラムをわかったように言わないで。不愉快だわ","translation":"巴鲁斯，别自作主张说得好像很了解拉姆一样。真让人不快。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"vo