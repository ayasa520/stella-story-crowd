,"script_background":{"mode":"native_array","resource":"bg/bg023c_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10120001:28","scenario_id":28,"scene_id":"scene:10120001","kind":"card","title_mode":"","speaker":"オットー","text":"野菜につけてよし、あえてよし、そのまま舐めてもよし！","translation":"蘸蔬菜也好，拌菜也好，直接舔着吃也好！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg023c_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10120001:29","scenario_id":29,"scene_id":"scene:10120001","kind":"card","title_mode":"","speaker":"オットー","text":"これほど万能な調味料、売れないはずがない！","translation":"这么万能的调味料，怎么可能不好卖！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg023c_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10120001:30","scenario_id":30,"scene_id":"scene:10120001","kind":"card","title_mode":"","speaker":"スバル","text":"その通りだよな！マヨネーズほど万能な調味料は存在しねえ！まさしく、神の味だ！","translation":"没错！没有比蛋黄酱更万能的调味料！简直是神的味道！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg023c_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10120001:31","scenario_id":31,"scene_id":"scene:10120001","kind":"card","title_mode":"","speaker":"オットー","text":"まあ、僕はあんまり得意じゃないので、\n中毒まで起こす人たちの気持ちは\nイマイチわかりませんが……","translation":"不过，我不太吃得惯，所以那些吃到上瘾的人，我也不太理解……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg023c_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10120001:32","scenario_id":32,"scene_id":"scene:10120001","kind":"card","title_mode":"","speaker":"スバル","text":"てめえ、この野郎！はしご外しかよ！","translation":"你这家伙！居然当场拆台！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg023c_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10120001:33","scenario_id":33,"scene_id":"scene:10120001","kind":"card","title_mode":"","speaker":"オットー","text":"まあまあ、売り手が商品に溺れるわけにいきませんし、よかったじゃありませんか","translation":"好了好了，卖东西的人自己可不能沉迷商品，这不也挺好吗。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg023c_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10120001:34","scenario_id":34,"scene_id":"sc