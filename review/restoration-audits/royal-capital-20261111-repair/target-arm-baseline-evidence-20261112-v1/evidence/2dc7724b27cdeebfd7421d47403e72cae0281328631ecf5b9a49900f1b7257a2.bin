anslation":"所以，感觉怎么样？有没有哪里不舒服喵？","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076a_roswaal","source_scenario_id":3},"native_video":null,"native_unsupported":""},{"id":"10030005:10","scenario_id":10,"scene_id":"scene:10030005","kind":"card","title_mode":"","speaker":"猫耳の少女","text":"命拾いして目が覚めて、最初に気にするのがそれにゃわけ？変な子、見つけちゃったかな？","translation":"捡回一条命，醒来之后第一件在意的事就是这个喵？好像捡到奇怪的孩子了呢。","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076a_roswaal","source_scenario_id":3},"native_video":null,"native_unsupported":""},{"id":"10030005:11","scenario_id":11,"scene_id":"scene:10030005","kind":"card","title_mode":"","speaker":"スバル","text":"そうだ！俺、路地裏で刺されてでも、腹の傷はない……","translation":"对了！我在巷子里被捅了，可肚子上的伤没了……","model":"subaru_gown01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076a_roswaal","source_scenario_id":3},"native_video":null,"native_unsupported":""},{"id":"10030005:12","scenario_id":12,"scene_id":"scene:10030005","kind":"card","title_mode":"","speaker":"男装の麗人","text":"目が覚めたようだな","translation":"看来你已经醒了。","model":"crusch01","body":"","