_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:14","scenario_id":14,"scene_id":"scene:10170003","kind":"card","title_mode":"","speaker":"スバル","text":"―――。","translation":"——。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122c_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:15","scenario_id":15,"scene_id":"scene:10170003","kind":"card","title_mode":"","speaker":"ヴィルヘルム","text":"そうした人間が行動に移すとき、周囲には相談しないことが多い。私も、身に覚えがあります","translation":"这样的人决定行动时，往往不会与旁人商量。我也有过类似的经历。","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122c_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:16","scenario_id":16,"scene_id":"scene:10170003","kind":"card","title_mode":"","speaker":"スバル","text":"……ヴィルヘルムさんのときは、\nどうなったんですか？ うまくいった？","translation":"……威尔海姆先生那时，结果如何？顺利吗？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122c_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:17","scenario_id":17,"scene_id":"scene:10170003","kind":"card","title_mode":"","speaker":"ヴィルヘルム","text":"いいえ、独断専行の結果、死にかけました。命を拾ったのは、妻と友のおかげです","translation":"不，独断专行的结果，便是险些丧命。多亏了妻子与友人，我才捡回一条命。","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122c_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:18","scenario_id":18,"scene_id":"scene:10170003","kind":"card","title_mode":"","speaker":"ヴィルヘルム","text":"私は、あなたにとってのそのどちらでもありませんが……若人の過ちを正すことは、年寄りの特権か、義務というべきでしょう","translation":"对您而言，我既非前者，也非后者……不过，纠正年轻人的过错，算是老人的特权，或许也该说是义务。","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122c_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:19","scenario_id":19,"scene_id":"scene:10170003","kind":"card","title_mode":"","speaker":"スバル","text":"ヴィルへルムさん!止めないでくれ！俺は、ここにいたら迷惑をかけるんだ！取り返しのつかない迷惑を。だから！","translation":"威尔海姆先生！别拦我！我待在这里，会给你们添麻烦的！会造成无法挽回的麻烦。所以！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122c_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:20","scenario_id":20,"scene_id":"scene:10170003","kind":"card","title_mode":"","speaker":"クルシュ","text":"だから、当家を去るのか？それはいささか、性急すぎる考えだな","translation":"所以，就要离开本家吗？这个想法，未免太急躁了。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122c_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:21","scenario_id":21,"scene_id":"scene:10170003","kind":"card","title_mode":"","speaker":"フェリス","text":"そうそう、フェリちゃん傷付く～。せっかく治してあげた子に、そんな簡単に命投げ出されちゃうなんて","translation":"就是就是，菲利酱可要伤心了～好不容易治好的孩子，竟然这么轻易就要去送命。","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122c_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:22","scenario_id":22,"scene_id":"scene:10170003","kind":"card","title_mode":"","speaker":"スバル","text":"クルシュさん、フェリスまで……","translation":"库珥修小姐，连菲利丝也……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122c_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:23","scenario_id":23,"scene_id":"scene:10170003","kind":"card","title_mode":"","speaker":"クルシュ","text":"自儘に、好きに生きるなら止めはしない。だが、ナツキ・スバル、考えを正そう","translation":"若是随心所欲，自由生活，我不会阻拦。然而，菜月昴，卿有一点想错了。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122c_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:24","scenario_id":24,"scene_id":"scene:10170003","kind":"card","title_mode":"","speaker":"クルシュ","text":"私は卿が好きに生きるのは止めない。しかし、好きに死ぬことを認めはしない","translation":"我不阻止卿自由地活，但绝不允许卿随意去死。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122c_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:25","scenario_id":25,"scene_id":"scene:10170003","kind":"card","title_mode":"","speaker":"スバル","text":"……俺は、好きに死ぬなんて","translation":"……我才没有，要随意去死……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122c_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10170003:26","scenario_id":26,"scene_id":"scene:10170003","kind":"card","title_mode":"","speaker":"クルシュ","text":"本当にそうか？卿はここを離れ、生きていく自信があると","