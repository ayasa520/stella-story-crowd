ure":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122a_crusch","source_scenario_id":17},"native_video":null,"native_unsupported":""},{"id":"10150003:28","scenario_id":28,"scene_id":"scene:10150003","kind":"card","title_mode":"","speaker":"スバル","text":"うーん、紳士……。\nもちろん、二人にも感謝してるけど、\nヴィルヘルムさんにも感謝ですよ","translation":"嗯～真是绅士……我当然也感谢他们两位，不过也很感谢威尔海姆先生。","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122a_crusch","source_scenario_id":17},"native_video":null,"native_unsupported":""},{"id":"10150003:29","scenario_id":29,"scene_id":"scene:10150003","kind":"card","title_mode":"","speaker":"ヴィルヘルム","text":"わかりました。では、そのお言葉、ありがたく","translation":"我明白了。那我便心怀感激，领受您的谢意。","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122a_crusch","source_scenario_id":17},"native_video":null,"native_unsupported":""},{"id":"10150003:30","scenario_id":30,"scene_id":"scene:10150003","kind":"card","title_mode":"","speaker":"フェリス","text":"はー、変に強情にゃんだから。\nでも、稽古の邪魔しちゃってごめんネ","translation":"唉，真是莫名固执喵。不过，打扰你练剑了，抱歉哦。","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122a_crusch","source_scenario_id":17},"native_video":null,"native_unsupported":""},{"id":"10150003:31","scenario_id":31,"scene_id":"scene:10150003","kind":"card","title_mode":"","speaker":"ヴィルヘルム","text":"いえ、ちょうど終えるところでした。邪魔になどなっていませんよ","translation":"不，正好也准备结束了，并没有打扰。","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122a_crusch","source_scenario_id":17},"native_video":null,"native_unsupported":""},{"id":"10150003:32","scenario_id":32,"scene_id":"scene:10150003","kind":"card","title_mode":"","speaker":"屋敷の使用人","text":"フェリス様、こちらでしたか。少し見てもらいたいものがありまして、今、お時間よろしいですか？","translation":"菲利丝大人，您在这里啊。有件东西想请您看看，现在方便吗？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122a_crusch","source_scenario_id":17},"native_video":null,"native_unsupported":""},{"id":"10150003:33","scenario_id":33,"scene_id":"scene:10150003","kind":"card","title_mode":"","speaker":"フェリス","text":"うん？見てもらいたいもの？は~い、今いく~!","translation":"嗯？想让我看看？好～我这就来～！","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_