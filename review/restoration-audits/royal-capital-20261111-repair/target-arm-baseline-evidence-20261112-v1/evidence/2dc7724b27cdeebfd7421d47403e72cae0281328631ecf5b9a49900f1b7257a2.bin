ってことだ）","translation":"（这个世界的饭菜也不差，但有一点我怎么也不能接受——没有蛋黄酱。）","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg023c_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10120001:38","scenario_id":38,"scene_id":"scene:10120001","kind":"card","title_mode":"","speaker":"スバル","text":"（俺ほどのマヨラーにとって、マヨ不足は致命的!じゃあどうするか…)","translation":"（对我这种蛋黄酱狂热爱好者来说，缺少蛋黄酱是致命的！那怎么办……）","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg023c_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10120001:39","scenario_id":39,"scene_id":"scene:10120001","kind":"card","title_mode":"","speaker":"スバル","text":"（なければ作ればいいじゃん!)","translation":"（没有，自己做不就好了！）","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg023c_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10120001:40","scenario_id":40,"scene_id":"scene:10120001","kind":"card","title_mode":"","speaker":"スバル","text":"（幸い、この世界の材料でも再現は\nできそうだった。だから試しに作って\nみたのが全ての始まり――）","translation":"（幸好，用这个世界的材料好像也能做出来。于是，我试着动手，一切就此开始——）","model":"","body"