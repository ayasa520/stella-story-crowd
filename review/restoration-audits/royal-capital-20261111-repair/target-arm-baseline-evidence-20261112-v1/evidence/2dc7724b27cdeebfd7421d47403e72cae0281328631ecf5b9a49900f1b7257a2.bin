":"10130003:88","scenario_id":88,"scene_id":"scene:10130003","kind":"card","title_mode":"","speaker":"スバル","text":"無理か……。\n連中と渡り合えるような、\nそんなツテ、ねえしな……","translation":"不行吗……我也没有能和他们抗衡的人脉……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg024a_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130003:89","scenario_id":89,"scene_id":"scene:10130003","kind":"card","title_mode":"","speaker":"スバル","text":"――――。","translation":"——。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg024a_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130003:90","scenario_id":90,"scene_id":"scene:10130003","kind":"card","title_mode":"","speaker":"スバル","text":"いや、待てよ?ないなら作ればいいんじゃないか？","translation":"不，等等？没有的话，去建立不就好了？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg024a_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130003:91","scenario_id":91,"scene_id":"scene:10130003","kind":"card","title_mode":"","speaker":"スバル","text":"あの連中にカウンターを喰らわせる、\n一発逆転の手段……","translation":"给那帮人一记反击，一举逆转局面的办法……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg024a_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130003:92","scenario_id":92,"scene_id":"scene:10130003","kind":"card","title_mode":"","speaker":"スバル","text":"一か八かになるけど……構うかよ。\n今だって、このままじゃ大負けするんだ","translation":"虽然得赌一把……管他的。就算不赌，再这样下去也是满盘皆输。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg024a_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130003:93","scenario_id":93,"scene_id":"scene:10130003","kind":"card","title_mode":"","speaker":"スバル","text":"だったら、どんな賭けだろうと、やる価値はあるはずだ!","translation":"那不管是什么样的赌局，都值得一试！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg024a_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:1","scenario_id":1,"scene_id":"scene:10130004","kind":"title","title_mode":"scene","speaker":"","text":"アナスタシア・ホーシン","translation":"安娜塔西亚·合辛","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","c