","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg134a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10190009:4","scenario_id":4,"scene_id":"scene:10190009","kind":"card","title_mode":"","speaker":"スバル","text":"さっきはでかい口叩いちまったけど、この街って探し物するには広すぎねえ？","translation":"刚才我还夸下海口，可这座城用来找东西，是不是也太大了？","model":"subaru01","body":"act_tameiki","face":"face_punpun","extra_motions":[],"bank":"vo_adv_subaru","cue":"advk_subaru_akireru","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg134a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10190009:5","scenario_id":5,"scene_id":"scene:10190009","kind":"card","title_mode":"","speaker":"銀髪の少女","text":"だって、ここはルグニカ王国の王都だもの。大きくて人もたくさんなのは当然でしょ？","translation":"这里可是露格尼卡王国的王都呀。地方大、人又多，不是理所当然吗？","model":"emilia01","body":"act_unazuku","face":"face_normal","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg134a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10190009:6","scenario_id":6,"scene_id":"scene:10190009","kind":"card","title_mode":"","speaker":"銀髪の少女","text":"……あ、まさか、ここがどこかも知らなかったの？ええと……","translation":"……啊，难道你连这里是什么地方都不知道？