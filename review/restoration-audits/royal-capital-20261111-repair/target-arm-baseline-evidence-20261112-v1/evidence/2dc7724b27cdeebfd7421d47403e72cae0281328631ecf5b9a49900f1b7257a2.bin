enario_id":2},"native_video":null,"native_unsupported":""},{"id":"10120002:62","scenario_id":62,"scene_id":"scene:10120002","kind":"card","title_mode":"","speaker":"オットー","text":"だからこそですよ。\nあの人は、身内は優遇しますが、\n一度敵対すると、とても怖いって聞きますし","translation":"正因如此啊。听说那个人对自己人很照顾，可一旦为敌，就非常可怕。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg161a_carriage","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10120002:63","scenario_id":63,"scene_id":"scene:10120002","kind":"card","title_mode":"","speaker":"オットー","text":"ナツキさん、『マヨネーズ』で商売を始める\nとき、挨拶にいかなかったんでしょう？","translation":"菜月先生，您开始卖『蛋黄酱』时，没去拜访过吧？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg161a_carriage","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10120002:64","scenario_id":64,"scene_id":"scene:10120002","kind":"card","title_mode":"","speaker":"スバル","text":"そもそも、そういうのがあることすら知らなかったからなあ","translation":"我连还有这种规矩都不知道。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg161a_carriage","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"