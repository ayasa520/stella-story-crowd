rit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg134a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020021:16","scenario_id":16,"scene_id":"scene:10020021","kind":"card","title_mode":"","speaker":"スバル","text":"って、あれ？ 君、さっきの子じゃねえか。\nちょうどよかった！\n貧民街って、こっちの方向で合ってるか？","translation":"咦，等等？你不是刚才那个女孩吗。正好！贫民街是这个方向吧？","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg134a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020021:17","scenario_id":17,"scene_id":"scene:10020021","kind":"card","title_mode":"","speaker":"ヴィル爺","text":"おや、お知り合いでしたか","translation":"哦，两位认识？","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg134a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020021:18","scenario_id":18,"scene_id":"scene:10020021","kind":"card","title_mode":"","speaker":"フェリス","text":"んん～？ どこかで会ったっけ？\nこんな目つきが悪いうえに変な服装の子、\n一度会ったら忘れにゃいと思うけど……","translation":"嗯嗯～？在哪儿见过吗？眼神这么凶恶、衣服又古怪的孩子，见过一次应该就忘不掉喵……","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","reso