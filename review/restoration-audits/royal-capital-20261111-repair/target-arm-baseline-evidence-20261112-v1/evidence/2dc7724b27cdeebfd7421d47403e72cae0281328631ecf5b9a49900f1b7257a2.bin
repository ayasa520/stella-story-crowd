actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130002:35","scenario_id":35,"scene_id":"scene:10130002","kind":"card","title_mode":"","speaker":"ロム爺","text":"なるほど、確かに今の状況で、路上で売り捌くのは得策ではなかろうよ","translation":"原来如此，眼下在街上叫卖，的确不是上策。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130002:36","scenario_id":36,"scene_id":"scene:10130002","kind":"card","title_mode":"","speaker":"フェルト","text":"あの取り締まりの強化って、兄ちゃんたちのせいかよ！","translation":"原来加强查禁，都是因为你们啊！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130002:37","scenario_id":37,"scene_id":"scene:10130002","kind":"card","title_mode":"","speaker":"フェルト","text":"お蔭でこちとら、仕事がやりにくくなって困ってんだぞ！","translation":"害得我干活也不方便，正头疼呢！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"act