":"bg/bg046c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10450058:6","scenario_id":6,"scene_id":"scene:10450058","kind":"card","title_mode":"","speaker":"ユリウス","text":"エミリア様、今回の件に関してはお任せを。\n大事には至らぬよう計らっておきます","translation":"爱蜜莉雅大人，此事便交给我处理。我会尽量，不让事情闹大。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg046c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10450058:7","scenario_id":7,"scene_id":"scene:10450058","kind":"card","title_mode":"","speaker":"銀髪の少女","text":"ええ、ありがとうユリウス……\nじゃなくて、ユーリ……？\nあなたには何から何までしてもらって……","translation":"嗯，谢谢，尤里乌斯……不，是尤里……？你真是，帮我做了好多事……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg046c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10450058:8","scenario_id":8,"scene_id":"scene:10450058","kind":"card","title_mode":"","speaker":"ユリウス","text":"真の功労者は私ではなく、彼です。私はあくまで、彼の求めに応えたまで。ねぎらいの言葉はぜひ彼に","translation":"真正立下功劳的，并非我，而是他。我不过回应了他的请求。慰劳之言，还请对他说吧。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg046