false},"script_background":{"mode":"native_array","resource":"bg/bg122a_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10150005:26","scenario_id":26,"scene_id":"scene:10150005","kind":"card","title_mode":"","speaker":"ヴィルヘルム","text":"そうですな。これで植える種を選べます。それで、クルシュ様は何を……","translation":"是啊，这样便能挑选种子了。那么，库珥修大人想种什么……","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122a_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10150005:27","scenario_id":27,"scene_id":"scene:10150005","kind":"card","title_mode":"","speaker":"クルシュ","text":"待て、ヴィルヘルム。言ったはずだ。\nこの花壇は卿らに任せると。\nならば、植える種も自分たちで選ぶといい","translation":"等等，威尔海姆。我说过，这片花坛交给你们。既然如此，要种什么，也由你们自己决定。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122a_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10150005:28","scenario_id":28,"scene_id":"scene:10150005","kind":"card","title_mode":"","speaker":"クルシュ","text":"何が花開こうと、私は咎めはしない。むしろ、楽しみに待つとしよう","translation":"不论开出什么花，我都不会责怪。倒不如说，我很期待。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"scri