"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg040b_felthouse","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10420008:8","scenario_id":8,"scene_id":"scene:10420008","kind":"card","title_mode":"","speaker":"フェルト","text":"うっせー！問答無用だ！とっとと消えろって言ってんだろ！","translation":"吵死了！没什么好说的！都叫你赶紧消失了！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg040b_felthouse","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10420008:9","scenario_id":9,"scene_id":"scene:10420008","kind":"battle","title_mode":"","speaker":"","text":"","translation":"","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg040b_felthouse","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10420008:10","scenario_id":10,"scene_id":"scene:10420008","kind":"card","title_mode":"","speaker":"フェルト","text":"大体、なんでアタシの名前知ってんだ？アタシに何の用があってきたんだよ","translation":"再说，你为什么知道我的名字？到底找我干什么？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["",