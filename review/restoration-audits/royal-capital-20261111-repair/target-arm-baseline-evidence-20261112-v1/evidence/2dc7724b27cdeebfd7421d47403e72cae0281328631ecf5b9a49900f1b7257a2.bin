009","kind":"card","title_mode":"","speaker":"スバル","text":"よっしゃあ！てなわけで、交渉成立！","translation":"好耶！那么，交易成立！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10420009:9","scenario_id":9,"scene_id":"scene:10420009","kind":"card","title_mode":"","speaker":"スバル","text":"じゃ、話は終わりとして、\nこれからみんなで商談成立の祝いに、\n一杯やりに行こうぜ！","translation":"好，谈完了。接下来，大家一起去喝一杯，庆祝成交吧！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10420009:10","scenario_id":10,"scene_id":"scene:10420009","kind":"card","title_mode":"","speaker":"フェルト","text":"ちょっと待て。\nなんでそんなに急いでんだ？","translation":"等等。为什么这么着急？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10420009:11","scenario_id":11,"scene_id":"scene:10420009","kind":"card","title_mode":"","speaker":"フェルト","text":"はあ？　危険って何がだよ？\n……なんか、最初っから引っかかんだよ。\nロム爺、この兄ちゃん、怪しくねーか？","translation":"啊？危险？有什么危险？……从一开始我就觉得不对。罗姆爷，这哥哥不可疑吗？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10420009:12","scenario_id":12,"scene_id":"scene:10420009","kind":"card","title_mode":"","speaker":"ロム爺","text":"確かに、何から何まで怪しい若僧じゃが\n誰でも後ろ暗いものの一つや二つ\n持ってて当然ではあるからの","translation":"的确，怎么看都是个可疑的小子。不过，谁没有一两件见不得光的事。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10420009:13","scenario_id":13,"scene_id":"scene:10420009","kind":"card","title_mode":"","speaker":"スバル","text":"ナイス解説だぜ、ロム爺！","translation":"解释得好，罗姆爷！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10420009:14","scenario_id":14,"scene_id":"scene:10420009","kind":"card","title_mode":"","speaker":"フェルト","text":"つーかさ、そもそもなんで兄ちゃんがこの徽章を欲しがんだよ？","translation":"话说回来，哥哥为什么想要这枚徽章？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10420009:15","scenario_id":15,"scene_id":"scene:10420009","kind":"card","title_mode":"","speaker":"フェルト","text":"この徽章はなんだ？実はこいつには、この見た目以上の価値があるんだろ？","translation":"这徽章究竟是什么？其实，它有超出外表的价值吧？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10420009:16","scenario_id":16,"scene_id":"scene:10420009","kind":"card","title_mode":"","speaker":"フェルト","text":"は?持ち主に返す?つくならもっとマシな嘘をつけよ。","translation":"啊？还给失主？要撒谎，也编个像样点的。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10420009:17","scenario_id":17,"scene_id":"scene:10420009","kind":"card","title_mode":"","speaker":"フェルト","text":"この徽章のホントの価値がわかんねーと、ここで即決はしてやれね一な","translation":"弄不清这徽章真正的价值，我可没法当场拍板。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10420009:18","scenario_id":18,"scene_id":"scene:10420009","kind":"card","title_mode":"","speaker":"スバル","text":"くっ……！\n時間がないんだ！　頼む、フェルト！","translation":"唔……！没时间了！求你了，菲鲁特！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10420009:19","scenario_id":19,"scene_id":"scene:10420009","kind":"card","title_mode":"","speaker":"フェルト","text":"さっきっから、時間ってなんだよこっちにゃ依頼人だっているんだあっちとも話さね一と筋が通らね一だろ","translation":"从刚才起就一直说没时间，到底怎么回事？我还有委托人，不和她谈谈，也说不过去吧。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10420009:20","scenario_id":20,"scene_id":"scene:10420009","kind":"card","title_mode":"","speaker":"フェルト","text":"なんで兄ちゃんがそれ知ってんだよ？\n兄ちゃんが関係者なら、ますます徽章の\n本当の値打ちは怪しくなるな","translation":"哥哥怎么知道的？你要是相关人士，这枚徽章的真正价值，就更值得怀疑了。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":