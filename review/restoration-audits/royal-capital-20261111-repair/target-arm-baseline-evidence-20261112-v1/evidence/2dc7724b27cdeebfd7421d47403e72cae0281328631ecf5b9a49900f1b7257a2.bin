picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040053:5","scenario_id":5,"scene_id":"scene:10040053","kind":"card","title_mode":"","speaker":"ユリウス","text":"徽章……?それも銀髪の女性の？それはもしや……","translation":"徽章……？而且，是银发女性的？难道是……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040053:6","scenario_id":6,"scene_id":"scene:10040053","kind":"card","title_mode":"","speaker":"スバル","text":"俺はそれを買い取りたい。そしてなるべく素早くここを立ち去りたい","translation":"我想把它买下来，然后尽快离开这里。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040053:7","scenario_id":7,"scene_id":"scene:10040053","kind":"card","title_mode":"","speaker":"ロム爺","text":"ふん、わけありじゃの。フェルトの仕事まで知っとるなら、話が早いわい","translation":"哼，看来有内情啊。既然连菲鲁特的活儿都知道，那便好说了。","model":"rom01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_dela