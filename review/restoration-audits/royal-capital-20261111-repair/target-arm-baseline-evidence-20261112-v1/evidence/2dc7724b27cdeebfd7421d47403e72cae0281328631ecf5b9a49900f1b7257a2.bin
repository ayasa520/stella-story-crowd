枚铜币。\n连这个都看不懂，你真没问题吗？","model":"kadomon01","body":"act_nayamu","face":"face_nayamu","extra_motions":[],"bank":"vo_adv_kadomon","cue":"advk_kadomon_rakutan","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg008a_fruitshop","source_scenario_id":22},"native_video":null,"native_unsupported":""},{"id":"10010001:26","scenario_id":26,"scene_id":"scene:10010001","kind":"card","title_mode":"","speaker":"果物屋の店主","text":"で、リンガ、どうだ？","translation":"所以，要不要来个凛果？","model":"kadomon01","body":"act_hohoemu","face":"face_hohoemu","extra_motions":[],"bank":"vo_adv_kadomon","cue":"advk_kadomon_saisoku","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg008a_fruitshop","source_scenario_id":22},"native_video":null,"native_unsupported":""},{"id":"10010001:27","scenario_id":27,"scene_id":"scene:10010001","kind":"card","title_mode":"","speaker":"果物屋の店主","text":"こりゃあ、どこの国の金だ？\nこんなもんルグニカ王国じゃ使えねえぞ","translation":"这是什么国家的钱？\n这种东西，在露格尼卡王国可用不了。","model":"kadomon01","body":"act_nayamu","face":"face_nayamu","extra_motions":[],"bank":"vo_adv_kadomon","cue":"advg_kadomon_gimon","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg008a_fruitshop","source_scenario_id":22},"native_video":null,"native_unsupported":""},{"id":"10010001:28","scenario_id":28,"scene_id":"scene:10010001","kind":"c