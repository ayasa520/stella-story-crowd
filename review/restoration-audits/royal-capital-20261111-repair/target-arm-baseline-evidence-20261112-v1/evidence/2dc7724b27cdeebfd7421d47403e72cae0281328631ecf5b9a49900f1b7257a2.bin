ode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:50","scenario_id":50,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"スバル","text":"いや、持ち主の子が、\nすげぇ大切にしてるものだってことは、\n知ってるけど、それ以外は……","translation":"不，我只知道，那个女孩非常珍视它。除此之外……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:51","scenario_id":51,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"クルシュ","text":"その持ち主の特徴は？","translation":"那位主人，有什么特征？","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:52","scenario_id":52,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"スバル","text":"やっぱり、知ってるんだな？頼む!教えてくれ!","translation":"你果然认识她吧？拜托了！告诉我！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:53","scenario_id":53,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"フェリス","text":"……クルシュ様、まさかとは\n思いますけど、スバルきゅんって\nあっちの陣営の回し者だったりとか？","translation":"……库珥修大人，该不会，小昴其实是对方阵营派来的眼线吧？","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:54","scenario_id":54,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"ヴィルヘルム","text":"いえ、これまでの行動から見ても、私はとてもそのようには思えません","translation":"不，从他迄今为止的行动来看，我实在不认为会如此。","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:55","scenario_id":55,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"クルシュ","text":"私も、ヴィルヘルムと同意見だ。\nそれに、ナツキ・スバルは嘘は\nついていない。それは確かなことだ","translation":"我与威尔海姆意见一致。而且，菜月昴并未说谎。这一点毋庸置疑。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:56","scenario_id":56,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"フェリス","text":"クルシュ様がそう仰るなら、もちろん、間違いないですけど～","translation":"既然库珥修大人这么说，那当然是不会有错啦～","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:57","scenario_id":57,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"スバル","text":"今の話……俺、もしかして何か疑われてたりした？","translation":"刚才那些话……难道，我被怀疑了吗？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:58","scenario_id":58,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"クルシュ","text":"疑惑、というほどのものではない。それに、卿の今日までの行いと発言で、それもすぐに晴れたと言っておこう","translation":"还称不上疑虑。况且，凭卿直到今日的言行，这点顾虑很快便消散了。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:59","scenario_id":59,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"クルシュ","text":"それで、徽章を返すと卿は言ったな。\nいったい、その徽章の持ち主と\n卿の間にどのような関係がある？","translation":"那么，卿说要归还徽章。卿与那枚徽章的主人之间，究竟是什么关系？","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:60","scenario_id":60,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"スバル","text":"……恩人、のはずなんだ。そりゃもう、クルシュさんたちに負けず劣らずなぐらいの、俺の大恩人","translation":"……应该是，恩人。她也是我的大恩人，对我的恩情，一点也不比库珥修小姐你们少。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:61","scenario_id":61,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"スバル","text":"だから、すっかり遅くなっちまったけど、俺はあの子にこれを返してやりたいんだ。絶対にな","translation":"所以，虽然已经耽误了很久，我还是想把它还给那个女孩。无论如何。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:62","scenario_id":62,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"クルシュ","text":"……そうか","translation":"……这样啊。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:63","scenario_id":63,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"クルシュ","text":"この短期間に何があったかわからないが、為すべきことを見つけたいい目をしている","translation":"虽不知这短短时日里发生了什么，但卿的眼神很好，像是找到了自己应做之事。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:64","scenario_id":64,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"クルシュ","text":"ナツキ・スバル、最初の質問に答えよう。私はその徽章の持ち主を知っている","translation":"菜月昴，来回答卿最初的问题吧。我认识那枚徽章的主人。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:65","scenario_id":65,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"スバル","text":"本当か！？","translation":"真的！？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:66","scenario_id":66,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"クルシュ","text":"ああ、その徽章の持ち主はエミリア。メイザース辺境伯の屋敷にいる","translation":"嗯，那枚徽章的主人叫爱蜜莉雅。她住在梅札斯边境伯的宅邸。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:67","scenario_id":67,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"スバル","text":"エミリア。エミリアか……それが、あの子の名前なんだな","translation":"爱蜜莉雅。爱蜜莉雅啊……那就是，她的名字啊。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:68","scenario_id":68,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"クルシュ","text":"ああ。私も、辺境伯とは知らぬ仲ではない。\n卿がそれをエミリアへ渡したいというなら、\n屋敷までの竜車を用意しよう","translation":"嗯，我与边境伯也有些交情。若卿想亲手交给爱蜜莉雅，我便为卿安排前往宅邸的龙车。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:69","scenario_id":69,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"スバル","text":"屋敷までの竜車って、そこまでしてもらっていいのか？","translation":"连去宅邸的龙车都要帮我安排？可以麻烦你到这种地步吗？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:70","scenario_id":70,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"クルシュ","text":"卿の真摯な思いを酌んだまでだ。\n何よりその徽章、エミリアの手元にあって\nくれた方が、私にとってもありがたい","translation":"只是体谅卿的一片赤诚。更何况，那枚徽章回到爱蜜莉雅手上，对我而言也更为妥当。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:71","scenario_id":71,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"クルシュ","text":"すぐに竜車を手配しよう。フェリス。お前がナツキ・スバルに同行して送り届けてくれ","translation":"立刻安排龙车吧。菲利丝，由你陪同菜月昴，将他送到那里。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:72","scenario_id":72,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"フェリス","text":"かしこまりました。クルシュ様","translation":"遵命，库珥修大人。","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:73","scenario_id":73,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"スバル","text":"とんとん拍子で実感湧かねぇけど……\nフェリス、よろしく頼む","translation":"进展这么顺利，我都有点没实感……菲利丝，拜托了。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":35},"native_video":null,"native_unsupported":""},{"id":"10160010:74","scenario_id":74,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"フェリス","text":"いいっていいって。\nクルシュ様のご命令だし、スバルきゅん\n一人でいかせて、ご無礼があっても困るしネ","translation":"没事没事。这是库珥修大人的命令，而且让小昴一个人过去，要是有什么失礼之处，也很困扰喵。","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","b