ce":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg046c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10450057:18","scenario_id":18,"scene_id":"scene:10450057","kind":"card","title_mode":"","speaker":"ユリウス","text":"そう言ってもらえるなら、光栄だ","translation":"能得到如此评价，不胜荣幸。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg046c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10450058:1","scenario_id":1,"scene_id":"scene:10450058","kind":"title","title_mode":"scene","speaker":"","text":"君の名前は","translation":"你的名字是","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"","source_scenario_id":null},"native_video":null,"native_unsupported":""},{"id":"10450058:2","scenario_id":2,"scene_id":"scene:10450058","kind":"text","title_mode":"","speaker":"","text":"――盗品蔵に現れた銀髪の少女を交えて、徽\n章の返却如何が話題にのぼる。徽章を盗んだ\n当の本人であるフェルトは……","translation":"——银发少女来到赃物库后，众人谈起了归还徽章的事。而偷走徽章的当事人，菲鲁特……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"bg/bg046c_stealshop","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"mus