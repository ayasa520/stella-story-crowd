":"card","title_mode":"","speaker":"エルザ","text":"あら、意外ね。冗談を言うような殿方には、見えなかったのだけれど","translation":"哎呀，真意外。您看起来可不像是会开玩笑的男士。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10460038:8","scenario_id":8,"scene_id":"scene:10460038","kind":"card","title_mode":"","speaker":"ロム爺","text":"フェルト、退くぞ!こうなっては取引きどころではないわい","translation":"菲鲁特，我们走！都这样了，还谈什么交易。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10460038:9","scenario_id":9,"scene_id":"scene:10460038","kind":"card","title_mode":"","speaker":"フェルト","text":"でも、あの徽章が……","translation":"可是，那枚徽章……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10460038:10","scenario_id":10,"scene_id":"scene:10460038","kind":"card","title_mode":"","speaker":"ロム爺","text":"命あっての物種よ。この場はあのジジイらに任せよ。儂らはいくぞ、ついてこい！","translation":"活着才有以后。这里交给那个老头他们，我们走，跟上！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10460038:11","scenario_id":11,"scene_id":"scene:10460038","kind":"card","title_mode":"","speaker":"フェルト","text":"クソ、覚えとけよ、黒女！\nテメー、絶対に許さねーかんな！","translation":"可恶，给我记住，黑衣女！我绝对饶不了你！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10460038:12","scenario_id":12,"scene_id":"scene:10460038","kind":"card","title_mode":"","speaker":"スバル","text":"おうおう、威勢よく飛び出していっちまったな","translation":"哦哦，气势十足地跑出去了啊。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10460038:13","scenario_id":13,"scene_id":"scene:10460038","kind":"card","title_mode":"","speaker":"フェリス","text":"清々しい逃げ足。でも、賢明な判断だよネ","translation":"逃得真干脆。不过，是个明智的决定呢。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_imag