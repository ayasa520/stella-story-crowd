":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg069a_fountain","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040042:6","scenario_id":6,"scene_id":"scene:10040042","kind":"card","title_mode":"","speaker":"スバル","text":"狙い通り、ってのもあれだが、\nこうやってきてくれたのはありがたいぜ","translation":"虽然说如我所料，也有点怪，不过，能这样过来，真是帮大忙了。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg069a_fountain","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040042:7","scenario_id":7,"scene_id":"scene:10040042","kind":"card","title_mode":"","speaker":"ミミ","text":"ねえねえ、おにーさん、\nミミ、それほしー！ ダメ？","translation":"喂喂，哥哥，蜜蜜想要那个！不行吗？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg069a_fountain","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040042:8","scenario_id":8,"scene_id":"scene:10040042","kind":"card","title_mode":"","speaker":"ミミ","text":"やたー!おに一さん太っ腹ですな！","translation":"太好了！哥哥，真大方！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],