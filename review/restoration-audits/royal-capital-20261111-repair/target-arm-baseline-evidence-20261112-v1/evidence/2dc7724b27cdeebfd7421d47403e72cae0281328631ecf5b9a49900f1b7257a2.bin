afeteria","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:11","scenario_id":11,"scene_id":"scene:10130004","kind":"card","title_mode":"","speaker":"アナスタシア","text":"ナツキくんやったね？いったい、どこでこれを知ったん？","translation":"你叫菜月吧？到底从哪儿知道这个的？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg057a1_cafeteria","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:12","scenario_id":12,"scene_id":"scene:10130004","kind":"card","title_mode":"","speaker":"スバル","text":"べ、別に、どこで知ったかなんてどうでもいいだ……でしょう","translation":"哪、哪里知道的，不重要……吧。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg057a1_cafeteria","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:13","scenario_id":13,"scene_id":"scene:10130004","kind":"card","title_mode":"","speaker":"アナスタシア","text":"無理して敬語やのうてもええよ？この場は対等な交渉の場なんやし、ウチとナツキくんは対等な立場や","translation":"不用勉强说敬语哦。这里是平等的谈判桌，我和菜月的立场也平等。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg057a1_cafeteria","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:14","scenario_id":14,"scene_id":"scene:10130004","kind":"card","title_mode":"","speaker":"スバル","text":"そ、そうか。そう言ってくれると、こっちも助かる","translation":"是、是吗。你这么说，倒也帮了大忙。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg057a1_cafeteria","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:15","scenario_id":15,"scene_id":"scene:10130004","kind":"card","title_mode":"","speaker":"スバル","text":"とにかく、こっちが出せるのはマヨネーズの作り方だ","translation":"总之，我能拿出来的筹码，是蛋黄酱的做法。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg057a1_cafeteria","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:16","scenario_id":16,"scene_id":"scene:10130004","kind":"card","title_mode":"","speaker":"スバル","text":"大事なのは作り方で、レシピの出所なんてどうでもいいだろ？","translation":"重要的是做法，配方的来历无所谓吧？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg057a1_cafeteria","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:17","scenario_id":17,"scene_id":"scene:10130004","kind":"card","title_mode":"","speaker":"アナスタシア","text":"ま、そうやね。ウチもちょっと興味あっただけやし","translation":"也是，我只是有一点好奇。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg057a1_cafeteria","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:18","scenario_id":18,"scene_id":"scene:10130004","kind":"card","title_mode":"","speaker":"アナスタシア","text":"それで、『マヨネーズ』の作り方を\n教える代わりに、\nナツキくんがウチに頼むのは……","translation":"那么，作为教我『蛋黄酱』做法的交换，菜月要拜托我的是……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg057a1_cafeteria","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:19","scenario_id":19,"scene_id":"scene:10130004","kind":"card","title_mode":"","speaker":"スバル","text":"オットーを助けたい。どうか、力を貸してくれ！頼む！","translation":"我想救奥托。请助我一臂之力！拜托了！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg057a1_cafeteria","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:20","scenario_id":20,"scene_id":"scene:10130004","kind":"card","title_mode":"","speaker":"アナスタシア","text":"一生懸命なんは買うけども、商人がそう簡単に頭下げるもんやないよ","translation":"你的认真，我很欣赏。不过，商人可不能随便低头。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg057a1_cafeteria","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:21","scenario_id":21,"scene_id":"scene:10130004","kind":"card","title_mode":"","speaker":"アナスタシア","text":"そんなんやと、相手に付け込まれてまうよ？","translation":"那样会被对方趁虚而入哦。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg057a1_cafeteria","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:22","scenario_id":22,"scene_id":"scene:10130004","kind":"card","title_mode":"","speaker":"スバル","text":"気持ちはありがたいけど、この場は俺の本気を示す方が優先だ。そのためなら、頭なんていくらでも下げる","translation":"谢谢提醒，可现在，让你明白我的认真更重要。为此，低多少次头都可以。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg057a1_cafeteria","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:23","scenario_id":23,"scene_id":"scene:10130004","kind":"card","title_mode":"","speaker":"アナスタシア","text":"そこまで真剣なんは、商人としては落第やけど、人間としては好感が持てるわ","translation":"这么认真，身为商人是不及格，可身为一个人，倒让人很有好感。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg057a1_cafeteria","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:24","scenario_id":24,"scene_id":"scene:10130004","kind":"card","title_mode":"","speaker":"アナスタシア","text":"でも、ナツキくんのお願い……。相手が相手やし、だいぶしんどそうやね","translation":"不过，你的请求……对方毕竟是那种人，会很难办呢。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg057a1_cafeteria","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:25","scenario_id":25,"scene_id":"scene:10130004","kind":"card","title_mode":"","speaker":"スバル","text":"アナスタシアさんでも、なのか？","translation":"就算是安娜塔西亚小姐，也一样吗？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg057a1_cafeteria","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:26","scenario_id":26,"scene_id":"scene:10130004","kind":"card","title_mode":"","speaker":"アナスタシア","text":"たぶん、人質に価値があるってわかったら、向こうも相当ふっかけてくるやろしね","translation":"要是知道人质有价值，对方肯定也会狮子大开口。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg057a1_cafeteria","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:27","scenario_id":27,"scene_id":"scene:10130004","kind":"card","title_mode":"","speaker":"アナスタシア","text":"ナツキくんはその友達のために、妥協するつもりはないんやろ？","translation":"你为了那个朋友，也没打算妥协吧？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg057a1_cafeteria","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:28","scenario_id":28,"scene_id":"scene:10130004","kind":"card","title_mode":"","speaker":"スバル","text":"妥協って、例えば？","translation":"妥协，比如说？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg057a1_cafeteria","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130004:29","scenario_id":29,"scene_id":"scene:10130004","kind":"card","title_mode":"","speaker":"アナスタシア","text":"例えば、手足の一、二本なくなってるとか、\n首から上がないとか……","translation":"比如，少一两只手脚，或者脖子上面不见了……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action