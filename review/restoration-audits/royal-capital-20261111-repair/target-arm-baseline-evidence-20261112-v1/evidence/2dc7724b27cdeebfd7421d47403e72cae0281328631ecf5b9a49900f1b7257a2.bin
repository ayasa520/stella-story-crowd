],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg024a_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10160010:6","scenario_id":6,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"スバル","text":"徽章があって、あの女がいて、\n盗品蔵は荒れ放題で、フェルトもロム爺も\nいなくなってて……！","translation":"徽章在那里，那个女人也在那里，赃物库乱成一团，菲鲁特和罗姆爷都不见了……！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg024a_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10160010:7","scenario_id":7,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"スバル","text":"じゃあ、何が本当で何が嘘なんだよ！あれは夢じゃなかったのか!？誰か……誰か、教えてくれよ！","translation":"那到底什么是真的，什么是假的！那不是梦吗！？谁来……谁来告诉我啊！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg024a_slum","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10160010:8","scenario_id":8,"scene_id":"scene:10160010","kind":"card","title_mode":"","speaker":"スバル","text":"―――。","translation":"——。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,