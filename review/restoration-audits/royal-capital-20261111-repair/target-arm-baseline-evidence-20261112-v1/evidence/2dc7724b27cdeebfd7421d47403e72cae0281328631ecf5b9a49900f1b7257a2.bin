6","scenario_id":16,"scene_id":"scene:10210006","kind":"card","title_mode":"","speaker":"ロム爺","text":"そうじゃな、儂ならうまく流して金貨四、五枚か","translation":"这个嘛，老夫若找个好买家，能卖四五枚金币吧。","model":"rom01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10210006:17","scenario_id":17,"scene_id":"scene:10210006","kind":"card","title_mode":"","speaker":"スバル","text":"なら、単純に買い取り価格は倍ってことか。相手もかなり本気だな","translation":"那买价就直接翻倍了啊。看来对方也很认真。","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10210006:18","scenario_id":18,"scene_id":"scene:10210006","kind":"card","title_mode":"","speaker":"ロム爺","text":"いや、聖金貨は素材が希少な聖金を使っておるから、聖金十枚の価値は金貨二十枚近くある","translation":"不，圣金币用的是稀有的圣金，十枚圣金币，价值接近二十枚普通金币。","model":"rom01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10210006:19","scenario_id":19,"scene_id":"scene:10210006","kind":"c