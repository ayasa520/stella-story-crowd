ranslation":"哦，以物易物？你有什么值钱东西？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020037:11","scenario_id":11,"scene_id":"scene:10020037","kind":"card","title_mode":"","speaker":"巨大な体躯の老人","text":"珍奇な格好なのは気付いておったわい。とはいえ、なるほど……お前さんの様子、物によっては物々交換はありかもしれんな","translation":"老夫当然看出你的衣服古怪。不过，原来如此……看你这样，要是东西合适，以物易物倒也未尝不可。","model":"rom01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020037:12","scenario_id":12,"scene_id":"scene:10020037","kind":"card","title_mode":"","speaker":"スバル","text":"お、さすが！見る目があるぜ","translation":"哦，厉害！有眼光。","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020037:13","scenario_id":13,"scene_id":"scene:10020037","kind":"card","title_mode":"","speaker":"巨大な体躯の老人","text":"しかし、さっきから気になっておったが、お前さん、その妙な品はなんなんじゃ？","translation":"不过，老夫从刚才就在意了，你那个怪东西是什么？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020037:14","scenario_id":14,"scene_id":"scene:10020037","kind":"card","title_mode":"","speaker":"巨大な体躯の老人","text":"べすと……?何を言うとるのかわからんが、見たいのはそれじゃ。ほれ、貸してみい","translation":"最什么……？听不懂你在说什么，老夫想看的是那个。来，给我看看。","model":"rom01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020037:15","scenario_id":15,"scene_id":"scene:10020037","kind":"card","title_mode":"","speaker":"スバル","text":"おいおい、丁重に扱ってくれよ。もう他じゃ食えないかもしれねえんだ。まあ、ミミにほぼ食われたんだが……","translation":"喂喂，给我小心点啊。说不定以后再也吃不到了。虽然差不多都让蜜蜜吃掉了……","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020037:16","scenario_id":16,"scene_id":"scene:10020037","kind":"card","title_mode":"","speaker":"巨大な体躯の老人","text":"ほう……これが食い物とは……。むぐむぐ……なるほど、不思議な味じゃ。酒にも合う。うましうまし","translation":"哦……这竟然是吃的……嚼嚼……原来如此，真是奇妙的味道。也很下酒。好吃，好吃。","model":"rom01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020037:17","scenario_id":17,"scene_id":"scene:10020037","kind":"card","title_mode":"","speaker":"スバル","text":"そーだろそーだろ……って、\n勝手に食ってんじゃねえ！\nミミと同レベルかよ！","translation":"对吧对吧……等等，别擅自吃啊！你和蜜蜜一个德行吗！","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020037:18","scenario_id":18,"scene_id":"scene:10020037","kind":"card","title_mode":"","speaker":"巨大な体躯の老人","text":"ま、何と交換するつもりか知らんが、フェルトがきてから出直してくるんじゃな","translation":"算了，不知道你想拿什么换，总之等菲鲁特来了再来吧。","model":"rom01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020037:19","scenario_id":19,"scene_id":"scene:10020037","kind":"card","title_mode":"","speaker":"スバル","text":"あー、クソ、持ってかれた……ええい、了解、オーライ、わかったよ。おとなしく外で待たせてもらうわ","translation":"啊——可恶，又被抢走了……行行行，知道了，明白了。我会老老实实在外