],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg013a_street","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040001:15","scenario_id":15,"scene_id":"scene:10040001","kind":"card","title_mode":"","speaker":"果物屋の店主","text":"何も買わずに質問たあいい度胸だ。まあ、聞くだけ聞いてやるが、なんだよ","translation":"什么都不买就来问问题，胆子不小啊。算了，姑且听听，什么事？","model":"kadomon01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg013a_street","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040001:16","scenario_id":16,"scene_id":"scene:10040001","kind":"card","title_mode":"","speaker":"スバル","text":"ちょっと前に、この辺でスリの騒ぎとかなかった？","translation":"不久之前，这附近有没有发生扒窃的骚动？","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg013a_street","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040001:17","scenario_id":17,"scene_id":"scene:10040001","kind":"card","title_mode":"","speaker":"果物屋の店主","text":"スリねえ……そんな騒ぎなんか、珍しくも何ともねえよ","translation":"扒窃啊……那种骚动，一点也不稀奇。","model":"kadomon01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg013a_street","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040001:18","scenario_id":18,"scene_id":"scene:10040001","kind":"card","title_mode":"","speaker":"果物屋の店主","text":"珍しいだあ?そう言われりゃ、確かにそうか。あれは珍しかったかもしれねえな","translation":"稀奇？这么一说，确实如此。那件事，倒可能挺稀奇。","model":"kadomon01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg013a_street","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040001:19","scenario_id":19,"scene_id":"scene:10040001","kind":"card","title_mode":"","speaker":"果物屋の店主","text":"そういう意味じゃ、さっきの騒ぎはでかかったな。通りで魔法が二、三発ぶっ放されてよ","translation":"要这么说，刚才的骚动可不小。有人在街上，接连放了两三发魔法。","model":"kadomon01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg013a_street","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040001:20","scenario_id":20,"scene_id":"scene:10040001","kind":"card","title_mode":"","speaker":"スバル","text":"ぐ、出遅れたか……徽章を盗まれるのを阻止すれば、状況が変えられると思ったんだが","translation":"唔，来晚了吗……还想着只要阻止徽章被偷，就能改变状况。","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"scri