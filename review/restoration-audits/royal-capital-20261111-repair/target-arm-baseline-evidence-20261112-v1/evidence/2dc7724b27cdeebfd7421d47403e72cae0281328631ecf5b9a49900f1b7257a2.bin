……わ、渡さねぇ……","translation":"这、这个……绝、绝不给你……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg103a_forest","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10160011:54","scenario_id":54,"scene_id":"scene:10160011","kind":"card","title_mode":"","speaker":"エルザ","text":"頑張るのは素敵だけど、声が震えているわよ","translation":"努力的样子很动人，不过，你的声音在发抖哦。","model":"elsa01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg103a_forest","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10160011:55","scenario_id":55,"scene_id":"scene:10160011","kind":"card","title_mode":"","speaker":"スバル","text":"へ、へへ……よ、よく見てやがれよ……ここにあります徽章を、グッと握って・","translation":"嘿、嘿嘿……看、看仔细了……把这里的徽章，紧紧握住……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg103a_forest","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10160011:56","scenario_id":56,"scene_id":"scene:10160011","kind":"card","title_mode":"","speaker":"スバル","text":"そして、手を開く。すると……ほ、ほら","translation":"然后，把手打开。于是……看、看吧。","model":"","body":"","face":"","extra_motions":[],"bank":"","cu