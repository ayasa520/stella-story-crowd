e_unsupported":""},{"id":"10020021:28","scenario_id":28,"scene_id":"scene:10020021","kind":"card","title_mode":"","speaker":"フェリス","text":"女の子が危ない目にって……ええ？まさか、君が助けにいく気にゃの？","translation":"女孩遇到危险……诶？难不成，你打算去救她喵？","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg134a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020021:29","scenario_id":29,"scene_id":"scene:10020021","kind":"card","title_mode":"","speaker":"スバル","text":"疑わしい気持ちになるのはわかるけど、本当のことなんだから仕方ねえ。とにかく、それで急いでるんだよ！","translation":"我知道这听着很可疑，可这就是事实。总之，我就是为这个赶时间！","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg134a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020021:30","scenario_id":30,"scene_id":"scene:10020021","kind":"card","title_mode":"","speaker":"フェリス","text":"にゃんだか只事じゃない感じ？","translation":"听起来情况不太寻常喵？","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg134a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020021:31","sce