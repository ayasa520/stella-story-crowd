称呼。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076a_roswaal","source_scenario_id":3},"native_video":null,"native_unsupported":""},{"id":"10030005:16","scenario_id":16,"scene_id":"scene:10030005","kind":"card","title_mode":"","speaker":"フェリス","text":"クルシュ様、クルシュ様、気にするところってそこですかあ？","translation":"库珥修大人，库珥修大人，您在意的是这个吗？","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076a_roswaal","source_scenario_id":3},"native_video":null,"native_unsupported":""},{"id":"10030005:17","scenario_id":17,"scene_id":"scene:10030005","kind":"card","title_mode":"","speaker":"スバル","text":"ってことは……","translation":"也就是说……","model":"subaru_gown01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076a_roswaal","source_scenario_id":3},"native_video":null,"native_unsupported":""},{"id":"10030005:18","scenario_id":18,"scene_id":"scene:10030005","kind":"card","title_mode":"","speaker":"フェリス","text":"お腹の傷はフェリちゃんが魔法で治したげたってわけ。で、あとは豪華なお屋敷で療養中ってとこ","translation":"肚子上的伤是菲利酱用魔法治好的。接下来就是在这座豪华宅邸里静养啦。","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076a_roswaal","source_scenario_id":3},"native_video":null,"native_unsupported":""},{"id":"10030005:19","scenario_id":19,"scene_id":"scene:10030005","kind":"card","title_mode":"","speaker":"フェリス","text":"それ褒めてるの？ふざけてるの？よくわかんにゃいんだけど","translation":"你这是在夸人家，还是在开玩笑喵？完全搞不清楚呢。","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076a_roswaal","source_scenario_id":3},"native_video":null,"native_unsupported":""},{"id":"10030005:20","scenario_id":20,"scene_id":"scene:10030005","kind":"card","title_mode":"","speaker":"スバル","text":"俺ちょっと状況見えてねえんだけど\nそっちの美人のお姉さんは……？","translation":"我还有点没弄清状况，那边那位漂亮的大姐姐是……？","model":"subaru_gown01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076a_roswaal","source_scenario_id":3},"native_video":null,"native_unsupported":""},{"id":"10030005:21","scenario_id":21,"scene_id":"scene:10030005","kind":"card","title_mode":"","speaker":"クルシュ","text":"挨拶が遅れたな。\n私はクルシュ・カルステン。\nカルステン家の当主にしてこの屋敷の主だ","translation":"介绍得晚了。我叫库珥修·卡尔斯腾，是卡尔斯腾家的当家，也是这座宅邸的主人。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076a_roswaal","source_scenario_id":3},"native_video":null,"native_unsupported":""},{"id":"10030005:22","scenario_id":22,"scene_id":"scene:10030005","kind":"card","title_mode":"","speaker":"クルシュ","text":"そして、これは私の騎士であるフェリス。\n治癒術師としては王国一の腕を持つ。\n卿の一時の安静と、当家への逗留を歓迎する","translation":"这位是我的骑士菲利丝，作为治愈术师，他拥有王国第一的本领。欢迎卿在本家暂住休养。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076a_roswaal","source_scenario_id":3},"native_video":null,"native_unsupported":""},{"id":"10030005:23","scenario_id":23,"scene_id":"scene:10030005","kind":"card","title_mode":"","speaker":"スバル","text":"なんか、すげぇ話が一気に飛び出したな！？\nお姉さんがクルシュさんで\n公爵で当主で美人！？","translation":"一下子冒出好多不得了的事啊！？姐姐叫库珥修，是公爵、当家，还是个大美人！？","model":"subaru_gown01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076a_roswaal","source_scenario_id":3},"native_video":null,"native_unsupported":""},{"id":"10030005:24","scenario_id":24,"scene_id":"scene:10030005","kind":"card","title_mode":"","speaker":"フェリス","text":"あはは、混乱してる混乱してる。いいよいいよ、どんどん悩みにゃさい。で、そんにゃ君のお名前は？","translation":"啊哈哈，混乱了混乱了。没关系，没关系，尽管慢慢苦恼喵。那，你叫什么名字呢？","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076a_roswaal","source_scenario_id":3},"native_video":null,"native_unsupported":""},{"id":"10030005:25","scenario_id":25,"scene_id":"scene:10030005","kind":"card","title_mode":"","speaker":"スバル","text":"あ……俺の名前は、ナツキ・スバルだ。一気呵成の一文無し、かな？","translation":"啊……我叫菜月昴。是个一鼓作气的穷光蛋，大概吧？","model":"subaru_gown01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076a_roswaal","source_scenario_id":3},"native_video":null,"native_unsupported":""},{"id":"10030005:26","scenario_id":26,"scene_id":"scene:10030005","kind":"card","title_mode":"","speaker":"フェリス","text":"別に、そんな不安がらなくても、お金取ったりしにゃいってば～、もう","translation":"真是的，不用那么不安啦，不会收你的钱喵～","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg076a_roswaal","source_scenario_id":3},"native_video":null,"native_unsupported":""},{"id":"10030006:1","scenario_id":1,"scene_id":"scene:10030006","kind":"title","title_mode":"scene","speaker":"","text":"クルシュ邸にて","translation":"在库珥修宅邸","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":""