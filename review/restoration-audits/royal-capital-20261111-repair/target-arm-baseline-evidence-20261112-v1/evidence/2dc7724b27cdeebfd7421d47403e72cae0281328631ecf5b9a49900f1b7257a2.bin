aracter_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg103a_forest","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10180005:6","scenario_id":6,"scene_id":"scene:10180005","kind":"card","title_mode":"","speaker":"エルザ","text":"すごいわ。ここまでついてこられるなんて·すごいお年寄りがいたものね","translation":"真厉害，竟然能跟到这个地步……世上居然还有这么厉害的老人。","model":"elsa01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg103a_forest","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10180005:7","scenario_id":7,"scene_id":"scene:10180005","kind":"card","title_mode":"","speaker":"ヴィルヘルム","text":"お褒めに与り、恐縮です。ですが、あなたの剣は邪に過ぎる。見ていてひどく不愉快だ","translation":"承蒙夸奖，不胜惶恐。不过，您的剑太过邪恶，看着令人十分不快。","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg103a_forest","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10180005:8","scenario_id":8,"scene_id":"scene:10180005","kind":"card","title_mode":"","speaker":"エルザ","text":"あら、つれないのね。邪道と言われたら反論できないのだけれど、この剣であなたのお腹を抉ってあげるわ","translation":"哎呀，真冷淡。说是邪道，我倒也无从反驳。不过，我会用这把剑，剜开你的肚子。","model":"elsa01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg103a_forest","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10180005:9","scenario_id":9,"scene_id":"scene:10180005","kind":"card","title_mode":"","speaker":"","text":"繰り広げられる激戦、ヴィルヘルムとエルザの剣戟、それを竜車組は固唾を呑んで見守っていた。","translation":"威尔海姆与艾尔莎展开激烈的交锋，龙车上的众人屏息凝神，注视着这场剑戟之战。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg103a_forest","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10180005:10","scenario_id":10,"scene_id":"scene:10180005","kind":"card","title_mode":"","speaker":"スバル","text":"おいおい、なんだあの戦い……。\nヴィルヘルムさんってすげえんだな……","translation":"喂喂，那是什么战斗啊……威尔海姆先生，原来这么厉害……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg103a_forest","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10180005:11","scenario_id":11,"scene_id":"scene:10180005","kind":"card","title_mode":"","speaker":"フェリス","text":"そっかそっか。\nスバルきゅんはヴィル爺が戦うところ\n見たことなかったもんネ","translation":"对哦，对哦。小昴还没见过威尔爷战斗的样子呢。","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voi