,"text":"別に何も言ってね一だろ。存分にはしゃげよ。アタシは儲かればそれでいーし","translation":"我又没说什么。你尽管高兴呗，反正我只要有钱赚就行。","model":"felt01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10290008:20","scenario_id":20,"scene_id":"scene:10290008","kind":"card","title_mode":"","speaker":"エルザ","text":"それじゃ、交渉はおしまいね。残念だけど、私は引き上げさせてもらうわ","translation":"那么，谈判结束了呢。虽然很遗憾，不过我就先告辞了。","model":"elsa01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10290008:21","scenario_id":21,"scene_id":"scene:10290008","kind":"card","title_mode":"","speaker":"スバル","text":"あー、悪いな、エルザさん。たぶん、怒られたりしちまうよな……","translation":"啊，真不好意思，艾尔莎小姐。你大概会被骂吧……","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10290008:22","scenario_id":22,"scene_id":"scene:10290008","kind":"card","title_mode":"","speaker":"エルザ","text":"仕方のない話よ。雇い主が支払いを少なく済まそうなんて考えたのが悪いのだし","tra