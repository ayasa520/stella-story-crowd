バル","text":"ここがフェルトのねぐらか……","translation":"这里，就是菲鲁特的窝啊……","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg040b_felthouse","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040043:5","scenario_id":5,"scene_id":"scene:10040043","kind":"card","title_mode":"","speaker":"ミミ","text":"おー、ポロボロ！なんか、懐かしい感じのやつ","translation":"哦～破破烂烂的！有种，好怀念的感觉。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg040b_felthouse","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040043:6","scenario_id":6,"scene_id":"scene:10040043","kind":"card","title_mode":"","speaker":"リカード","text":"やれやれ、ようやく見つかったわな。\nこれだけでも結構、骨が折れたで、\n兄ちゃん","translation":"哎呀呀，终于找到了。光这一步，就折腾得够呛啊，小哥。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg040b_felthouse","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040043:7","scenario_id":7,"scene_id":"scene:10040043","kind":"card","title_mode":"","speaker":"スバル","text":"悪かった。けど、助かったよ。聞き込みするのも、俺だけじゃ舐められてこんなスムーズにいかなかったかもだし","translation":"抱歉。不过，多亏你们了。要是我一个人去打听，说不定会被人小看，就没这么顺利了。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg040b_felthouse","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040043:8","scenario_id":8,"scene_id":"scene:10040043","kind":"card","title_mode":"","speaker":"ミミ","text":"ひゃほーっ！ベッドガタガター！","translation":"呀吼～！床摇摇晃晃的！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg040b_felthouse","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040043:9","scenario_id":9,"scene_id":"scene:10040043","kind":"card","title_mode":"","speaker":"リカード","text":"うおい!ミミ！勝手に人の家に上がったらあかんやろ！家主が戻ったらどないすんねん！","translation":"喂！蜜蜜！别随便进人家屋里啊！屋主回来了咋办！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg040b_felthouse","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040043:10","scenario_id":10,"scene_id":"scene:10040043","kind":"card","title_mode":"","speaker":"フェルト","text":"その家主のお戻りだよ。テメーら、アタシの家で何してやがる","translation":"屋主回来了。你们，在我家干什么？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg040b_felthouse","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040043:11","scenario_id":11,"scene_id":"scene:10040043","kind":"card","title_mode":"","speaker":"フェルト","text":"生憎と、アタシの家にゃ\n盗るもんなんざ何もねーぞ。\nとっとと失せろ！","translation":"可惜，我家可没有什么能偷的东西。赶紧滚！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg040b_felthouse","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040043:12","scenario_id":12,"scene_id":"scene:10040043","kind":"card","title_mode":"","speaker":"スバル","text":"フェルト！戻ってきたか！","translation":"菲鲁特！你回来了！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg040b_felthouse","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10040043:13","scenario_id":13,"scene_id":"scene:10040043","kind":"card","title_mode":"","speaker":"フェルト","text":"ああ?なんでアタシの名前……。でかい獣人とチビの獣人ニ人連れで、アタシに何の用なんだよ、怪しい兄ちゃん","translation":"啊？为什么知道我的名字……带着个大兽人和小兽人，找我有什么事啊，可疑的哥哥？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emiss