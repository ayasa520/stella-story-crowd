","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg040b_felthouse","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10420008:14","scenario_id":14,"scene_id":"scene:10420008","kind":"card","title_mode":"","speaker":"フェルト","text":"なんだか、兄ちゃんがアタシの依頼人からなんかされたみて一な言い草だな。アタシも面倒事は御免だぜ？","translation":"听起来，哥哥像是被我的委托人做过什么。我也不想惹麻烦啊。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg040b_felthouse","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10420008:15","scenario_id":15,"scene_id":"scene:10420008","kind":"card","title_mode":"","speaker":"スバル","text":"俺だって御免だ。とにかく、日が暮れる前に取引を済ませたい","translation":"我也不想。总之，想在天黑前完成交易。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg040b_felthouse","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10420008:16","scenario_id":16,"scene_id":"scene:10420008","kind":"card","title_mode":"","speaker":"フェルト","text":"ずいぶん焦ってんな……。まあ、いいさ。で？兄ちゃんはいくら出すんだ？","translation":"真着急啊……也好。所以，哥哥出多少钱？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_a