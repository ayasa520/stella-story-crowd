,"resource":"bg/bg031a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130002:41","scenario_id":41,"scene_id":"scene:10130002","kind":"card","title_mode":"","speaker":"スバル","text":"だから、俺の知ってる中で、\n一番顔が広くて、信用できそうなロム爺に\n売人を紹介してもらおうと思ったわけだ","translation":"所以，我才来找认识的人里，人脉最广、看着也最值得信任的罗姆爷，想请你介绍贩子。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130002:42","scenario_id":42,"scene_id":"scene:10130002","kind":"card","title_mode":"","speaker":"フェルト","text":"あんなひで一別れ方したくせに、よくここに顔出そうなんて考えられたな","translation":"上次都闹成那样了，你居然还想得出再来。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031a_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10130002:43","scenario_id":43,"scene_id":"scene:10130002","kind":"card","title_mode":"","speaker":"フェルト","text":"兄ちゃん、面の皮、厚すぎじゃね一か？","translation":"哥哥，你这脸皮也太厚了吧？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031a_stealshop","source_scenario_id":2},"nativ