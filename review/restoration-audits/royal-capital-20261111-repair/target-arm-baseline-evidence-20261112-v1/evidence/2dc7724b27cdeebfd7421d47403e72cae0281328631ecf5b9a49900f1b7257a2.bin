":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122a_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10150004:38","scenario_id":38,"scene_id":"scene:10150004","kind":"card","title_mode":"","speaker":"ヴィルヘルム","text":"それは……","translation":"这……","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122a_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10150004:39","scenario_id":39,"scene_id":"scene:10150004","kind":"card","title_mode":"","speaker":"フェリス","text":"こーら、反論しにゃいの。\nクルシュ様のご命令だよ？ ヴィル爺、\nそれを断れる立場じゃないでしょ","translation":"好啦，不许反驳喵。这可是库珥修大人的命令哦？威尔爷可没有拒绝的立场吧。","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg122a_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10150004:40","scenario_id":40,"scene_id":"scene:10150004","kind":"card","title_mode":"","speaker":"フェリス","text":"クルシュ様のお人柄を思えば、\nこんなこと、冗談でやらせると思う？","translation":"想想库珥修大人的为人，她会开玩笑，让你做这种事吗？","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":""