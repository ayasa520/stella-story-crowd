,"script_background":{"mode":"native_array","resource":"bg/bg103a_forest","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10160011:6","scenario_id":6,"scene_id":"scene:10160011","kind":"card","title_mode":"","speaker":"スバル","text":"そ、そんなんじゃねえっての。あの子は恩人で、ただの超絶美少女だ","translation":"才、才不是那样。她是我的恩人，还是个超级美少女，仅此而已。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg103a_forest","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10160011:7","scenario_id":7,"scene_id":"scene:10160011","kind":"card","title_mode":"","speaker":"フェリス","text":"ただそれだけ、って感じじゃにゃいけど、ま、フェリちゃんはこれ以上、突っ込んであげないことにしたのでした","translation":"听起来可不只是这样喵。不过，菲利酱决定不再继续追问啦。","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg103a_forest","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10160011:8","scenario_id":8,"scene_id":"scene:10160011","kind":"card","title_mode":"","speaker":"スバル","text":"うるせぇやい。\n……それで、あとどれぐらいでつくんだ？","translation":"啰嗦。……所以，还要多久才到？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg