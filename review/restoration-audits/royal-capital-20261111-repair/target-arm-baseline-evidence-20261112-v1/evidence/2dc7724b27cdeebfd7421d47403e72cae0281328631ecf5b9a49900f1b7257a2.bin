pported":""},{"id":"10110003:33","scenario_id":33,"scene_id":"scene:10110003","kind":"card","title_mode":"","speaker":"スバル","text":"――――。","translation":"——。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10110003:34","scenario_id":34,"scene_id":"scene:10110003","kind":"card","title_mode":"","speaker":"スバル","text":"あるじゃねえか、まともな装備！","translation":"有啊，像样的装备！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10110003:35","scenario_id":35,"scene_id":"scene:10110003","kind":"card","title_mode":"","speaker":"スバル","text":"このケータイを売っぱらえば、当面の生活には困らないはず！","translation":"把这部手机卖掉，暂时应该就不用为生活发愁了！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031b_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10110003:36","scenario_id":36,"scene_id":"scene:10110003","kind":"card","title_mode":"","speaker":"スバル","text":"いや、ダメだ。それじゃ、当面はよくてもいずれは野垂れ死ん