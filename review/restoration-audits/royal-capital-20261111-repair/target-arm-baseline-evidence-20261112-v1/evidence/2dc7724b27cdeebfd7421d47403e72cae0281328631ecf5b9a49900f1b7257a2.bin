","speaker":"ミミ","text":"っ!おにーさん!!","translation":"！小哥哥！！","model":"mimi01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10240046:19","scenario_id":19,"scene_id":"scene:10240046","kind":"text","title_mode":"","speaker":"","text":"一瞬、何が起きたのかわからない。\n何か、熱い感触が腹を掠めたと思ったら、\n足から力が抜けていた。","translation":"一瞬间，他不知道发生了什么。只觉得有什么灼热的东西掠过腹部，双腿便失去了力气。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10240046:20","scenario_id":20,"scene_id":"scene:10240046","kind":"card","title_mode":"","speaker":"エルザ","text":"ふふっ、残念でした。\n落ち着くにはまだ早かったわね？","translation":"呵呵，真遗憾。现在就松口气，还太早了吧？","model":"elsa_nomantle01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg031c_stealshop","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10240046:21","scenario_id":21,"scene_id":"scene:10240046","kind":"card","title_mode":"","speaker":"スバル","text":"あ……え、るざ……?","translation":"啊……艾、尔莎……？","model":"