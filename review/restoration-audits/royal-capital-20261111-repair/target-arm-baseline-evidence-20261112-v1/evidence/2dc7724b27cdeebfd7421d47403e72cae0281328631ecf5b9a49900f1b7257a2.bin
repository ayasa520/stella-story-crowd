rce_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:16","scenario_id":16,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"エミリア","text":"息災……でも、実はあんまり元気でいられる状況じゃなくて・","translation":"安然无恙……不过，其实现在的状况，实在没法让我打起精神……","model":"emilia01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:17","scenario_id":17,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"クルシュ","text":"ふむ、だろうな","translation":"嗯，我想也是。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:18","scenario_id":18,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"エミリア","text":"え？","translation":"诶？","model":"emilia01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:19","scenario_id":19,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"ロズワール","text":"おやおやおや、クルシュ様？\nその、だろーぉなという仰りよう、\nどういった意図があるかお伺いしても？","translation":"哎呀哎呀，库珥修大人？您这句『我想也是』，可否请教，其中有何深意～？","model":"roswaal01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:20","scenario_id":20,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"クルシュ","text":"なに、単純なことだ。卿らの抱えている問題について、こちらから会わせたいものがいてな","translation":"没什么，很简单。关于你们面临的问题，我们这边，有个人想介绍给你们。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:21","scenario_id":21,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"クルシュ","text":"出番だぞ、ナツキ・スバル","translation":"轮到卿出场了，菜月昴。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:22","scenario_id":22,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"スバル","text":"お、おうともさ！その、あはは、お久しぶり","translation":"哦、哦，交给我吧！那个，哈哈，好久不见。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:23","scenario_id":23,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"エミリア","text":"――？\nええと、あなたは……？","translation":"——？那个，你是……？","model":"emilia01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:24","scenario_id":24,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"スバル","text":"うぐ、眼中になしか……。いやいや、この周回じゃ仕方ねえ","translation":"唔，完全没印象啊……不不，这一轮也没办法。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:25","scenario_id":25,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"スバル","text":"なんせ、違う名前で呼び止めて、印象最悪で振り切られて終わりだし","translation":"毕竟，我叫错她的名字，留下了最糟糕的印象，最后还被甩开了。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:26","scenario_id":26,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"フェリス","text":"ちょっとちょっと、\nスバルきゅん、話が違うんじゃにゃい？","translation":"等一下，等一下。小昴，这和说好的不一样喵？","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:27","scenario_id":27,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"フェリス","text":"エミリア様は恩人って言ってたのに、\n向こうは知らないっぽいよ？","translation":"你说爱蜜莉雅大人是恩人，可她好像不认识你啊？","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:28","scenario_id":28,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"クルシュ","text":"待て、フェリス。ナツキ・スバルが嘘をついていないのは確かめた。あとは見守るしかない","translation":"等等，菲利丝。菜月昴没有说谎，这已经确认了。接下来，只能静观其变。","model":"crusch01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:29","scenario_id":29,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"スバル","text":"ぐおおお、背後から謎のプレッシャー。ええい、クソ、男は度胸だ！","translation":"呜哦哦，背后传来了莫名的压力。算了，可恶，男人就该拿出胆量！","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:30","scenario_id":30,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"スバル","text":"君は覚えてないかもしれない。でも、俺は君に返し切れない恩があって、それを返すためにここまできたんだ","translation":"也许你不记得了。不过，你对我有还不完的恩情，我为了报恩，才来到这里。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:31","scenario_id":31,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"エミリア","text":"私に？あなたが恩返しごめんなさい。やっぱり心当たりがなくて","translation":"我？你想报恩……对不起，我果然还是想不起来。","model":"emilia01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:32","scenario_id":32,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"スバル","text":"俺に心当たりはなくても、こいつには見覚えがあるんじゃないか？","translation":"就算对我没印象，这东西你总该认识吧？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:33","scenario_id":33,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"エミリア","text":"――っ！ それって……","translation":"——！那是……","model":"emilia01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg096b_roswaal","source_scenario_id":8},"native_video":null,"native_unsupported":""},{"id":"10200006:34","scenario_id":34,"scene_id":"scene:10200006","kind":"card","title_mode":"","speaker":"？？？","text":"あ――ッ！？\nな、なんでテメーがそれを！？","translation":"啊——！？你、你这家伙，为什么拿着那个！？","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"acti