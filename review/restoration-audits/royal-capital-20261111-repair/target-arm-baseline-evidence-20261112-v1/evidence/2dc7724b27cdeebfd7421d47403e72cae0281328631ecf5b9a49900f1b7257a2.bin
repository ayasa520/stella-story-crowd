","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10160007:9","scenario_id":9,"scene_id":"scene:10160007","kind":"card","title_mode":"","speaker":"ヴィルヘルム","text":"なるほど。スバル殿、覚書を拝見","translation":"原来如此。昴阁下，容我看看清单。","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10160007:10","scenario_id":10,"scene_id":"scene:10160007","kind":"card","title_mode":"","speaker":"ヴィルヘルム","text":"……確かに。お一人でこの量は大変でしょう","translation":"……确实，这个分量，让您一个人搬会很辛苦。","model":"wilhelm01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg125d_crusch","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10160007:11","scenario_id":11,"scene_id":"scene:10160007","kind":"card","title_mode":"","speaker":"フェリス","text":"でっしょ～？","translation":"就是说嘛～","model":"ferris_dress01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""]