,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg134a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020034:6","scenario_id":6,"scene_id":"scene:10020034","kind":"text","title_mode":"","speaker":"","text":"焦りと不安ばかりが肥大化して、\n思うように道は見つからない。","translation":"焦虑与不安不断膨胀，却始终找不到要走的路。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg134a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020034:7","scenario_id":7,"scene_id":"scene:10020034","kind":"text","title_mode":"","speaker":"","text":"戻らなくちゃならない盗品蔵へ\n戻るどころか、道を誤り、ぶつかり、\n焦燥は募る一方で","translation":"不仅没能回到必须赶回的赃物库，反而不断走错、碰壁，心中的焦躁也越来越强烈。","model":"","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"command":["","",""],"phases":[[],[],[]],"music":{"action":"inherit","resource":"","fade":1,"restart":false},"script_background":{"mode":"native_array","resource":"bg/bg134a_castletown","source_scenario_id":2},"native_video":null,"native_unsupported":""},{"id":"10020034:8","scenario_id":8,"scene_id":"scene:10020034","kind":"card","title_mode":"","speaker":"スバル","text":"ダメだ。人に聞こうとしても、端から貧民街なんて誰もいきたがらねえ。チクショウ、どうすりゃいい！","translation":"不行，想找人问路，可一提到贫民街，谁都不肯去。可恶，到底该怎么办！","model":"subaru01","body":"","face":"","extra_motions":[],"bank":"","cue":"","bg_picture":"","bg_music":"","character_image":"","movie_resource":"","actors":[],"voice_delay_ms":0,"fx_emission_times":[],"comman