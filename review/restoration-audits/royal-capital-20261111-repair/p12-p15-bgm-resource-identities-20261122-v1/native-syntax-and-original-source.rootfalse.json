        "from .scenario_parameters import ScenarioParameters",
        "",
        "",
        "def music_command(value, settings):",
        "    if not value.strip():",
        "        return dict(action=\"inherit\", resource=\"\", fade=settings[\"bgm_fade_seconds\"], restart=False)",
        "    parts = [p.strip() for p in next(csv.reader([value]))]",
        "    if len(parts) > 3 or not parts[0]:",
        "        raise ValueError(\"BGM 格式应为：曲目,渐变秒数,是否重播\")",
        "    fade = float(parts[1]) if len(parts) > 1 and parts[1] else settings[\"bgm_fade_seconds\"]",
        "    restart = json.loads(parts[2]) if len(parts) > 2 and parts[2] else False",
        "    if not math.isfinite(fade) or fade < 0 or type(restart) is not bool:",
        "        raise ValueError(\"BGM 渐变时间需为非负数，重播需为 true 或 false\")",
        "    return dict(action=\"stop\" if parts[0] == \"STOP\" else \"play\", resource=\"\" if parts[0] == \"STOP\" else parts[0],",
        "                fade=fade, restart=restart)"
      ]
    },
