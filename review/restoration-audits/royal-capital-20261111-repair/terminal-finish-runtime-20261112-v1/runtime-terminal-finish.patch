+/** Classify original FINISH destinations without manufacturing a successor.
+ * The preserved intro TITLE 41 uses the captured -1/-1 pair; its final card
+ * 102 omits both fields. ADV GetNext (logs/adv.html:7051-7084) completes normal
+ * ADV when FINISH does not name the current section, whereas a same-section
+ * positive destination loads that scene. This recognizes those native forms;
+ * it neither infers completion from title text/master is_end nor rewrites the
+ * source object. Partial, mixed and malformed destinations remain invalid.
+ */
+export function classifyFinishDestination(value: unknown): FinishDestination {
+  if (!ownObject(value) || value.next_scenario_label !== "FINISH" ||
+      typeof value.next_scenario_id !== "number" ||
+      !Number.isSafeInteger(value.next_scenario_id) || value.next_scenario_id < 0)
+    return {kind: "invalid"};
+  const absent = !Object.hasOwn(value, "next_section_id") && !Object.hasOwn(value, "next_scene_id");
+  const sentinel = value.next_section_id === -1 && value.next_scene_id === -1;
+  if (value.next_scenario_id === 0 && (absent || sentinel)) return {kind: "terminal"};
+  const sectionId = value.next_section_id, sceneId = value.next_scene_id;
+  if (typeof sectionId === "number" && Number.isSafeInteger(sectionId) && sectionId > 0 &&
+      typeof sceneId === "number" && Number.isSafeInteger(sceneId) && sceneId > 0)
+    return {kind: "target", sectionId, sceneId};
+  return {kind: "invalid"};
+}
