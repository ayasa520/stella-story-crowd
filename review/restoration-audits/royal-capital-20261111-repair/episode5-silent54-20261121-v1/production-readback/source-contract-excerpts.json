            "export async function loadStudioSnapshot(sha?:string,sceneIds:number[]=[initialStudioScene],",
            "  access:\"edit\"|\"read\"|\"scene\"=\"edit\"):Promise<StudioSnapshot>{",
            "  const repository=new GitHubRepository(),headSha=sha||await repository.head();",
            "  if(!/^[a-f\\d]{40}$/.test(headSha))throw new RepositoryError(\"脚本版本无效。\",400);",
            "  const {manifest}=await repository.library(headSha);",
            "  // The directory remains complete. On Workers the current section owns",
            "  // scene bodies and intra-section player state; a cross-section FINISH is",
            "  // executable from its native IDs without loading the next section.",
            "  const sections=new Set<number>();",
            "  if(env.STELLA_HOSTING===\"cloudflare\"){",
            "    for(const sceneId of sceneIds){",
            "      const entry=manifest.scenes.find(row=>row.id===sceneId);",
            "      if(entry)sections.add(entry.sectionId);",
            "    }",
            "    if(!sections.size){",
            "      const fallback=manifest.scenes.find(row=>row.id===initialStudioScene)||manifest.scenes[0];",
            "      if(!fallback)throw new RepositoryError(\"当前仓库还没有可编辑的场景。\",404);",
            "      sections.add(fallback.sectionId);",
            "    }",
            "  }",
            "  // If a whole section exceeds the Worker limit, the read-only editor can",
            "  // reopen just the requested scene. Saves and the continuous player still",
            "  // load the full section to retain cross-scene edits and transitions.",
            "  const narrow=access===\"scene\"&&sections.size>0;",
            "  const entries=narrow?[manifest.scenes.find(row=>row.id===sceneIds[0])||",
            "    manifest.scenes.find(row=>row.id===initialStudioScene)||manifest.scenes[0]]:",
            "    sections.size?manifest.scenes.filter(row=>sections.has(row.sectionId)):manifest.scenes;",
            "  const key=headSha+\":\"+(narrow?`scene:${entries[0].id}`:[...sections].sort((a,b)=>a-b).join(\",\"));"
          ]
        },
