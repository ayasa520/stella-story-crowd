            "export function chartLayout(program,node,completed,visitedEdges,settings){",
            "  const entries=new Map(program.directory.entries.map(row=>[row.id,row]));",
            "  const current=entries.get(node.scene_id),section=entries.get(current?.parent);",
            "  if(!current||!section)throw new Error('流程图缺少当前场景或所属话');",
            "  const scenes=[...entries.values()].filter(row=>row.kind==='scene'&&row.parent===section.id);",
            "  const positions=new Map(),{column,row,card_width:width,card_height:height,margin}=settings;",
            "  const minX=Math.min(...scenes.map(item=>item.pos_x)),minY=Math.min(...scenes.map(item=>item.pos_y));",
            "  for(const item of scenes){",
            "    if(!Number.isFinite(item.pos_x)||!Number.isFinite(item.pos_y))throw new Error('场景缺少有效的流程图坐标：'+item.id);",
            "    positions.set(item.id,{x:margin+(item.pos_x-minX)*column,y:margin+(item.pos_y-minY)*row});"
          ]
        },
        {
          "first": 21,
          "last": 35,
          "lines": [
            "  const visitedLinks=new Set(program.edges.filter(edge=>visitedEdges.has(edge.id)&&edge.transition.label==='FINISH')",
            "    .map(edge=>edge.source_scene+'>'+edge.target_scene));",
            "  const links=new Map();",
            "  const add=(source,target)=>{",
            "    if(positions.has(source)&&positions.has(target)){",
            "      const id=source+'>'+target;links.set(id,{id,source,target,visited:visitedLinks.has(id)});",
            "    }",
            "  };",
            "  for(const edge of program.directory.edges)if(edge.state==='confirmed')add(edge.source,edge.target);",
            "  for(const edge of program.edges)if(edge.state==='confirmed'&&edge.flow_action==='scene')add(edge.source_scene,edge.target_scene);",
            "  return {current,section,scenes,positions,links:[...links.values()],",
            "    viewBox:`${(maxX-viewWidth)/2} 0 ${viewWidth} ${maxY}`,",
            "    diagnostics:{section:section.id,current:current.id,unlockAll:program.preview_policy?.chart_unlock_all===true,",
            "      completed:[...completed],scenes:scenes.map(item=>({id:item.id,x:item.pos_x,y:item.pos_y,end:item.is_end})),",
            "      links:[...links.values()]}};"
          ]
        }
