            "export function classifyFinishDestination(value: unknown): FinishDestination {",
            "  if (!ownObject(value) || value.next_scenario_label !== \"FINISH\" ||",
            "      typeof value.next_scenario_id !== \"number\" ||",
            "      !Number.isSafeInteger(value.next_scenario_id) || value.next_scenario_id < 0)",
            "    return {kind: \"invalid\"};",
            "  const absent = !Object.hasOwn(value, \"next_section_id\") && !Object.hasOwn(value, \"next_scene_id\");",
            "  const sentinel = value.next_section_id === -1 && value.next_scene_id === -1;",
            "  if (value.next_scenario_id === 0 && (absent || sentinel)) return {kind: \"terminal\"};",
            "  const sectionId = value.next_section_id, sceneId = value.next_scene_id;",
            "  if (typeof sectionId === \"number\" && Number.isSafeInteger(sectionId) && sectionId > 0 &&",
            "      typeof sceneId === \"number\" && Number.isSafeInteger(sceneId) && sceneId > 0)",
            "    return {kind: \"target\", sectionId, sceneId};",
            "  return {kind: \"invalid\"};",
            "}",
            "",
            "export function indexSceneSections(manifest: Pick<LibraryManifest,\"chapters\">): Map<number,number> {",
            "  const sections=new Map<number,number>();",
            "  for(const chapter of manifest.chapters)for(const section of chapter.sections)for(const id of section.sceneIds)",
            "    sections.set(id,section.id);",
            "  return sections;",
            "}",
            "",
            "/** The full directory includes scenes whose scripts are absent or outside the",
            " * loaded section. Use it to check the declared pair so playback and editing",
            " * agree even when they load different subsets of scene documents.",
            " */",
            "export function finishSectionError(sectionId: number, sceneId: number, sections: ReadonlyMap<number,number>): string {",
            "  const owner=sections.get(sceneId);",
            "  if(owner===undefined)return `FINISH 目标场景 ${sceneId} 未登记在流程图目录中`;",
            "  return owner===sectionId?\"\":`FINISH 目标场景 ${sceneId} 属于 ${owner} 话，转移却指定了 ${sectionId} 话`;"
          ]
        }
      ]
    },
