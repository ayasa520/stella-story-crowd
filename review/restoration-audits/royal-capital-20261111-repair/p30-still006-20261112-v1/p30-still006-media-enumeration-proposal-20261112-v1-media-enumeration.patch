+def _picture_catalog(members, settings):
+    """Index native illustration IDs across independently configured sources.
+
+    A supplied source list is authoritative, including an explicitly empty
+    list. Older configurations keep their original single-prefix behavior.
+    Each source retains the same top-level filename and extension restrictions;
+    nested effect textures must never become stand-alone character_image IDs.
+    """
+    sources = settings.get("picture_sources")
+    if sources is None:
+        sources = [dict(prefix=settings["picture_prefix"],
+                        filename_prefix=settings["picture_filename_prefix"],
+                        extension=settings["picture_extension"])]
+    pictures = {}
+    ordered_members = sorted(members)
+    for source in sources:
+        prefix = source["prefix"]
+        for member in ordered_members:
+            relative = member.removeprefix(prefix)
+            if (member.startswith(prefix) and "/" not in relative
+                    and relative.startswith(source["filename_prefix"])
+                    and relative.endswith(source["extension"])):
+                key = PurePosixPath(member).stem
+                # Keys are native bare script IDs. Reject collisions across
+                # sources as well as within a source; never silently replace
+                # an existing illustration when another namespace is added.
+                if key in pictures:
+                    raise ValueError("重复剧情插图资源标识：" + key)
+                pictures[key] = dict(id=key, member=member, label=key)
+    return pictures
 
 
