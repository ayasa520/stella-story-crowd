      "firstLine": 77,
      "lastLine": 89,
      "text": "        const tick = timestamp => {\n          if (!enabled) return;\n          const at = performance.now(), node = document.body.dataset.node, shared = visualFrameClock.snapshot();\n          const row = {node, at, rafTimestamp: timestamp, callbackLag: at - timestamp,\n            deltaFromPrevious: previous === null ? null : at - previous,\n            opacity: Number(getComputedStyle(card).opacity), shared, phase: document.body.dataset.phase};\n          const animation = window.felt21Actor;\n          if (animation) {\n            row.actor = {time: animation.time, last: animation.last, running: animation.running,\n              model: animation.viewer.detail?.id, layers: [...animation.layers].map(([layer, state]) => ({layer, token: state.token, start: state.start, offset: state.offset}))};\n            const parameters = animation.viewer.core.getModel().parameters;\n            row.parameters = Object.fromEntries(parameterIds.map(id => [id, parameters.values[parameters.ids.indexOf(id)]]));\n          }"
    },
    "clockWrapperObjectBinding": {
      "file": {
        "path": "data/native_recovery/royal-capital-20261110/repair-20261111/visual-low/p11-felt21-production-review-v1/capture_four_previews.js",
        "bytes": 11062,
        "sha256": "7173f0609748c4f46428e170df6ea054e7b81a0f83015750d1cd04bdd886dc50"
      },
      "firstLine": 61,
      "lastLine": 71,
      "text": "        ActorAnimation.prototype.clock = function(...args) {\n          const before = this.time, priorLast = this.last, running = this.running;\n          const shared = this.visualClock.snapshot(), now = this.visualClock.now();\n          const result = originalClock.apply(this, args);\n          trace.actorClockCalls.push({node: document.body.dataset.node, model: this.viewer.detail?.id,\n            before, after: this.time, priorLast, running, shared, sharedNow: now,\n            sameClockObject: this.visualClock === visualFrameClock,\n            expectedAfter: before + (running ? now - priorLast : 0), at: performance.now()});\n          window.felt21Actor = this;\n          return result;\n        };"
    },
    "pngCopyAfterRead": {
      "file": {
        "path": "data/native_recovery/royal-capital-20261110/repair-20261111/visual-low/p11-felt21-production-review-v1/capture_four_previews.js",
        "bytes": 11062,
        "sha256": "7173f0609748c4f46428e170df6ea054e7b81a0f83015750d1cd04bdd886dc50"
      },
      "firstLine": 94,
      "lastLine": 106,
      "text": "            // Preserve the whole distinguishing arm/torso entry, including\n            // low-alpha frames. PNG readback has real cost: its start/end and\n            // observed rAF intervals are retained rather than called 30/60Hz.\n            if (row.elapsedGame <= 3.2 && (counts.get(node) || 0) < 140) {\n              const copyStart = performance.now();\n              capture.width = actor.width; capture.height = actor.height;\n              capture.getContext('2d').drawImage(actor, 0, 0);\n              trace.images.push({...row, copyStart, png: capture.toDataURL('image/png'), copyEnd: performance.now(),\n                canvas: {width: actor.width, height: actor.height}});\n              counts.set(node, (counts.get(node) || 0) + 1);\n            }\n          }\n          row.end = performance.now(); trace.raf.push(row); previous = at; requestAnimationFrame(tick);"
    },
